{
"metadata": {
"courseId": "weekend-camping",
"dialogueId": "cooking-dinner",
"title": "Nấu bữa tối",
"level": "beginner",
"situation": "Leo and Mia cook dinner beside the campfire.",
"scene": "/dialogue/weekend-camping/cooking-dinner/bg.png",
"thumbnail": "/dialogue/weekend-camping/thumbnails/weekend-camping-thumbnail4.png"
},
"dialogue": [
{
"id": 1,
"speaker": "Leo",
"text": "I'm getting hungry. Should we make dinner?",
"translation": "Mình bắt đầu thấy đói rồi. Chúng ta làm bữa tối nhé?",
"audioUrl": "/dialogue/weekend-camping/cooking-dinner/audio/leo-01.mp3"
},
{
"id": 2,
"speaker": "Mia",
"text": "Yes. What do we have?",
"translation": "Ừ. Chúng ta có gì vậy?",
"audioUrl": "/dialogue/weekend-camping/cooking-dinner/audio/mia-01.mp3"
},
{
"id": 3,
"speaker": "Leo",
"text": "We have noodles, eggs, and some vegetables.",
"translation": "Chúng ta có mì, trứng và một ít rau.",
"audioUrl": "/dialogue/weekend-camping/cooking-dinner/audio/leo-02.mp3"
},
{
"id": 4,
"speaker": "Mia",
"text": "Perfect. I'll boil the water.",
"translation": "Tuyệt. Mình sẽ đun nước.",
"audioUrl": "/dialogue/weekend-camping/cooking-dinner/audio/mia-02.mp3"
},
{
"id": 5,
"speaker": "Leo",
"text": "Great. I'll cut the vegetables.",
"translation": "Được đấy. Mình sẽ cắt rau.",
"audioUrl": "/dialogue/weekend-camping/cooking-dinner/audio/leo-03.mp3"
},
{
"id": 6,
"speaker": "Mia",
"text": "Can you pass me the pot?",
"translation": "Bạn đưa mình cái nồi được không?",
"audioUrl": "/dialogue/weekend-camping/cooking-dinner/audio/mia-03.mp3"
},
{
"id": 7,
"speaker": "Leo",
"text": "Sure. Here you go.",
"translation": "Được chứ. Đây này.",
"audioUrl": "/dialogue/weekend-camping/cooking-dinner/audio/leo-04.mp3"
},
{
"id": 8,
"speaker": "Mia",
"text": "Thanks. The water is boiling now.",
"translation": "Cảm ơn. Nước đang sôi rồi.",
"audioUrl": "/dialogue/weekend-camping/cooking-dinner/audio/mia-04.mp3"
},
{
"id": 9,
"speaker": "Leo",
"text": "Nice. Let's put the noodles in.",
"translation": "Tốt rồi. Chúng ta cho mì vào nhé.",
"audioUrl": "/dialogue/weekend-camping/cooking-dinner/audio/leo-05.mp3"
},
{
"id": 10,
"speaker": "Mia",
"text": "How long should we cook them?",
"translation": "Chúng ta nên nấu chúng trong bao lâu?",
"audioUrl": "/dialogue/weekend-camping/cooking-dinner/audio/mia-05.mp3"
},
{
"id": 11,
"speaker": "Leo",
"text": "About five minutes.",
"translation": "Khoảng năm phút.",
"audioUrl": "/dialogue/weekend-camping/cooking-dinner/audio/leo-06.mp3"
},
{
"id": 12,
"speaker": "Mia",
"text": "Okay. Dinner will be ready soon.",
"translation": "Được rồi. Bữa tối sắp xong rồi.",
"audioUrl": "/dialogue/weekend-camping/cooking-dinner/audio/mia-06.mp3"
}
],

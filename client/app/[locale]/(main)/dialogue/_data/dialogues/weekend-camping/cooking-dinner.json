"grammarNotes": [
{
"title": "get + adjective",
"explanation": "Dùng get + tính từ để nói một trạng thái đang thay đổi.",
"example": "I'm getting hungry. = Mình bắt đầu thấy đói."
},
{
"title": "Should we + verb...?",
"explanation": "Dùng Should we + động từ để đề nghị cùng nhau làm một việc.",
"example": "Should we make dinner? = Chúng ta làm bữa tối nhé?"
},
{
"title": "I'll + verb",
"explanation": "Dùng I'll + động từ để nói điều mình quyết định sẽ làm.",
"example": "I'll boil the water. = Mình sẽ đun nước."
},
{
"title": "Can you + verb...?",
"explanation": "Dùng Can you + động từ để nhờ ai đó làm một việc.",
"example": "Can you pass me the pot? = Bạn đưa mình cái nồi được không?"
},
{
"title": "How long...?",
"explanation": "Dùng How long để hỏi một việc kéo dài trong bao lâu.",
"example": "How long should we cook them? = Chúng ta nên nấu chúng trong bao lâu?"
}
]

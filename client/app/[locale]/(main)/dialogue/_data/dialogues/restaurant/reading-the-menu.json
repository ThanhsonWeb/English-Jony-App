  "grammarNotes": [
    {
      "title": "Hỏi mong muốn với “What do you want to...?”",
      "explanation": "Dùng “What do you want to + động từ...?” để hỏi một người muốn làm hoặc thử điều gì.",
      "example": "What do you want to try?"
    },
    {
      "title": "Gợi ý với “What about...?”",
      "explanation": "Dùng “What about + danh từ...?” để đưa ra một lựa chọn hoặc gợi ý.",
      "example": "What about the tomato soup?"
    }
  ]
}
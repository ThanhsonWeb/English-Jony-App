    "title": "Xem thực đơn",
    "level": "a1",
    "a1ContentRulesVersion": 2,
    "teachesContractions": [],
    "situation": "Ben và Emma xem thực đơn và nói về các món ăn. Họ hỏi nhau món nào trông ngon và món nào họ muốn thử.",
    "scene": "/dialogue/restaurant/reading-the-menu/bg.png",
    "thumbnail": "/dialogue/restaurant/thumbnails/reading-the-menu.png"
  },
  "dialogue": [
    {
      "id": 1,
      "speaker": "Emma",
      "text": "This table is nice. We can look at the menu now.",
      "translation": "Bàn này đẹp đấy. Bây giờ chúng ta có thể xem thực đơn.",
      "practicePriority": "simple",
      "scene": "/dialogue/restaurant/reading-the-menu/bg.png",
      "audioUrl": "/dialogue/restaurant/reading-the-menu/audio/emma-01.mp3"
    },
    {
      "id": 2,
      "speaker": "Ben",
      "text": "There are so many dishes on this menu.",
      "translation": "Có rất nhiều món trong thực đơn này.",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/reading-the-menu/bg.png",
      "audioUrl": "/dialogue/restaurant/reading-the-menu/audio/ben-01.mp3"
    },
    {
      "id": 3,
      "speaker": "Emma",
      "text": "What do you want to try?",
      "translation": "Bạn muốn thử món gì?",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/restaurant/reading-the-menu/bg.png",
      "audioUrl": "/dialogue/restaurant/reading-the-menu/audio/emma-02.mp3"
    },
    {
      "id": 4,
      "speaker": "Ben",
      "text": "The chicken pasta looks good.",
      "translation": "Món mì Ý gà trông ngon đấy.",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/reading-the-menu/bg.png",
      "audioUrl": "/dialogue/restaurant/reading-the-menu/audio/ben-02.mp3"
    },
    {
      "id": 5,
      "speaker": "Emma",
      "text": "I like pasta too, but I want something lighter.",
      "translation": "Mình cũng thích mì Ý, nhưng mình muốn món gì đó nhẹ hơn.",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/reading-the-menu/bg.png",
      "audioUrl": "/dialogue/restaurant/reading-the-menu/audio/emma-03.mp3"
    },
    {
      "id": 6,
      "speaker": "Ben",
      "text": "What about the tomato soup?",
      "translation": "Món súp cà chua thì sao?",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/reading-the-menu/bg.png",
      "audioUrl": "/dialogue/restaurant/reading-the-menu/audio/ben-03.mp3"
    },
    {
      "id": 7,
      "speaker": "Emma",
      "text": "That sounds good. Is it spicy?",
      "translation": "Nghe ngon đấy. Nó có cay không?",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/restaurant/reading-the-menu/bg.png",
      "audioUrl": "/dialogue/restaurant/reading-the-menu/audio/emma-04.mp3"
    },
    {
      "id": 8,
      "speaker": "Ben",
      "text": "I do not think so.",
      "translation": "Mình không nghĩ vậy.",
      "practicePriority": "simple",
      "scene": "/dialogue/restaurant/reading-the-menu/bg.png",
      "audioUrl": "/dialogue/restaurant/reading-the-menu/audio/ben-04.mp3"
    },
    {
      "id": 9,
      "speaker": "Emma",
      "text": "Then I want the tomato soup.",
      "translation": "Vậy thì mình muốn món súp cà chua.",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/reading-the-menu/bg.png",
      "audioUrl": "/dialogue/restaurant/reading-the-menu/audio/emma-05.mp3"
    },
    {
      "id": 10,
      "speaker": "Ben",
      "text": "I think I want the chicken pasta.",
      "translation": "Mình nghĩ mình muốn món mì Ý gà.",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/reading-the-menu/bg.png",
      "audioUrl": "/dialogue/restaurant/reading-the-menu/audio/ben-05.mp3"
    },
    {
      "id": 11,
      "speaker": "Emma",
      "text": "Great. We know what we want now.",
      "translation": "Tuyệt. Bây giờ chúng ta biết mình muốn món gì rồi.",
      "practicePriority": "simple",
      "scene": "/dialogue/restaurant/reading-the-menu/bg.png",
      "audioUrl": "/dialogue/restaurant/reading-the-menu/audio/emma-06.mp3"
    },
    {
      "id": 12,
      "speaker": "Ben",
      "text": "Yes. We are ready to order.",
      "translation": "Ừ. Chúng ta đã sẵn sàng gọi món.",
      "practicePriority": "simple",
      "scene": "/dialogue/restaurant/reading-the-menu/bg.png",
      "audioUrl": "/dialogue/restaurant/reading-the-menu/audio/ben-06.mp3"
    }
  ],

  },
  "dialogue": [
    {
      "id": 1,
      "speaker": "Emma",
      "text": "The tomato soup is really good. It is warm, but not spicy.",
      "translation": "Món súp cà chua rất ngon. Nó ấm nhưng không cay.",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/during-the-meal/bg.png",
      "audioUrl": "/dialogue/restaurant/during-the-meal/audio/emma-01.mp3"
    },
    {
      "id": 2,
      "speaker": "Emma",
      "text": "I like the bread too.",
      "translation": "Mình cũng thích bánh mì.",
      "practicePriority": "simple",
      "scene": "/dialogue/restaurant/during-the-meal/bg.png",
      "audioUrl": "/dialogue/restaurant/during-the-meal/audio/emma-02.mp3"
    },
    {
      "id": 3,
      "speaker": "Ben",
      "text": "My chicken pasta is good too. The chicken is very soft.",
      "translation": "Món mì Ý gà của mình cũng ngon. Thịt gà rất mềm.",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/during-the-meal/bg.png",
      "audioUrl": "/dialogue/restaurant/during-the-meal/audio/ben-01.mp3"
    },
    {
      "id": 4,
      "speaker": "Ben",
      "text": "I think this is my favorite dish here.",
      "translation": "Mình nghĩ đây là món mình thích nhất ở đây.",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/during-the-meal/bg.png",
      "audioUrl": "/dialogue/restaurant/during-the-meal/audio/ben-02.mp3"
    },
    {
      "id": 5,
      "speaker": "Emma",
      "text": "The soup is lighter, so it is perfect for me.",
      "translation": "Món súp nhẹ hơn nên rất hợp với mình.",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/during-the-meal/bg.png",
      "audioUrl": "/dialogue/restaurant/during-the-meal/audio/emma-03.mp3"
    },
    {
      "id": 6,
      "speaker": "Alex",
      "text": "How is everything? Is the food okay?",
      "translation": "Mọi thứ thế nào? Đồ ăn ổn chứ?",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/during-the-meal/bg.png",
      "audioUrl": "/dialogue/restaurant/during-the-meal/audio/alex-01.mp3"
    },
    {
      "id": 7,
      "speaker": "Ben",
      "text": "Everything is great, thank you.",
      "translation": "Mọi thứ đều rất tuyệt, cảm ơn bạn.",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/during-the-meal/bg.png",
      "audioUrl": "/dialogue/restaurant/during-the-meal/audio/ben-03.mp3"
    },
    {
      "id": 8,
      "speaker": "Emma",
      "text": "Can I have some more water, please?",
      "translation": "Tôi có thể xin thêm một ít nước được không?",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/restaurant/during-the-meal/bg.png",
      "audioUrl": "/dialogue/restaurant/during-the-meal/audio/emma-04.mp3"
    },
    {
      "id": 9,
      "speaker": "Alex",
      "text": "Of course. Do you need anything else?",
      "translation": "Tất nhiên. Bạn có cần thêm gì nữa không?",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/during-the-meal/bg.png",
      "audioUrl": "/dialogue/restaurant/during-the-meal/audio/alex-02.mp3"
    },
    {
      "id": 10,
      "speaker": "Emma",
      "text": "No, thank you. That is all.",
      "translation": "Không, cảm ơn bạn. Chỉ vậy thôi.",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/during-the-meal/bg.png",
      "audioUrl": "/dialogue/restaurant/during-the-meal/audio/emma-05.mp3"
    },
    {
      "id": 11,
      "speaker": "Alex",
      "text": "Great. Enjoy your meal.",
      "translation": "Tuyệt. Chúc hai bạn ngon miệng.",
      "practicePriority": "simple",
      "scene": "/dialogue/restaurant/during-the-meal/bg.png",
      "audioUrl": "/dialogue/restaurant/during-the-meal/audio/alex-03.mp3"
    }
  ],

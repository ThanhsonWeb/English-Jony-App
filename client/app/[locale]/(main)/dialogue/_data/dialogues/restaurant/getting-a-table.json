  },
  "dialogue": [
    {
      "id": 1,
      "speaker": "Alex",
      "text": "Good evening. How many people?",
      "translation": "Chào buổi tối. Có bao nhiêu người?",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/getting-a-table/bg.png",
      "audioUrl": "/dialogue/restaurant/getting-a-table/audio/alex-01.mp3"
    },
    {
      "id": 2,
      "speaker": "Ben",
      "text": "A table for two, please.",
      "translation": "Cho chúng tôi một bàn cho hai người.",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/restaurant/getting-a-table/bg.png",
      "audioUrl": "/dialogue/restaurant/getting-a-table/audio/ben-01.mp3"
    },
    {
      "id": 3,
      "speaker": "Alex",
      "text": "Do you have a reservation?",
      "translation": "Hai bạn có đặt bàn trước không?",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/getting-a-table/bg.png",
      "audioUrl": "/dialogue/restaurant/getting-a-table/audio/alex-02.mp3"
    },
    {
      "id": 4,
      "speaker": "Emma",
      "text": "No, we do not.",
      "translation": "Không, chúng tôi chưa đặt.",
      "practicePriority": "simple",
      "scene": "/dialogue/restaurant/getting-a-table/bg.png",
      "audioUrl": "/dialogue/restaurant/getting-a-table/audio/emma-01.mp3"
    },
    {
      "id": 5,
      "speaker": "Alex",
      "text": "That is fine. We have a table near the window.",
      "translation": "Không sao. Chúng tôi có một bàn gần cửa sổ.",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/getting-a-table/bg.png",
      "audioUrl": "/dialogue/restaurant/getting-a-table/audio/alex-03.mp3"
    },
    {
      "id": 6,
      "speaker": "Ben",
      "text": "Is it quiet near the window?",
      "translation": "Chỗ gần cửa sổ có yên tĩnh không?",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/getting-a-table/bg.png",
      "audioUrl": "/dialogue/restaurant/getting-a-table/audio/ben-02.mp3"
    },
    {
      "id": 7,
      "speaker": "Alex",
      "text": "Yes, it is. It is a quiet area.",
      "translation": "Có. Đó là một khu vực yên tĩnh.",
      "practicePriority": "simple",
      "scene": "/dialogue/restaurant/getting-a-table/bg.png",
      "audioUrl": "/dialogue/restaurant/getting-a-table/audio/alex-04.mp3"
    },
    {
      "id": 8,
      "speaker": "Emma",
      "text": "That sounds good.",
      "translation": "Nghe ổn đấy.",
      "practicePriority": "simple",
      "scene": "/dialogue/restaurant/getting-a-table/bg.png",
      "audioUrl": "/dialogue/restaurant/getting-a-table/audio/emma-02.mp3"
    },
    {
      "id": 9,
      "speaker": "Ben",
      "text": "We would like that table, please.",
      "translation": "Chúng tôi muốn chọn bàn đó.",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/restaurant/getting-a-table/bg.png",
      "audioUrl": "/dialogue/restaurant/getting-a-table/audio/ben-03.mp3"
    },
    {
      "id": 10,
      "speaker": "Alex",
      "text": "Great. The table is ready.",
      "translation": "Tuyệt. Bàn đã sẵn sàng.",
      "practicePriority": "simple",
      "scene": "/dialogue/restaurant/getting-a-table/bg.png",
      "audioUrl": "/dialogue/restaurant/getting-a-table/audio/alex-05.mp3"
    },
    {
      "id": 11,
      "speaker": "Emma",
      "text": "Thank you.",
      "translation": "Cảm ơn bạn.",
      "practicePriority": "simple",
      "scene": "/dialogue/restaurant/getting-a-table/bg.png",
      "audioUrl": "/dialogue/restaurant/getting-a-table/audio/emma-03.mp3"
    },
    {
      "id": 12,
      "speaker": "Alex",
      "text": "You are welcome. Enjoy your meal.",
      "translation": "Không có gì. Chúc hai bạn ngon miệng.",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/getting-a-table/bg.png",
      "audioUrl": "/dialogue/restaurant/getting-a-table/audio/alex-06.mp3"
    }
  ],

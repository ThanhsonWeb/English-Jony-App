"dialogue": [
{
"id": 1,
"speaker": "Maya",
"text": "Front desk. How can I help you?",
"translation": "Lễ tân đây. Tôi có thể giúp gì cho bạn?",
"practicePriority": "simple",
"scene": "/dialogue/at-a-hotel/asking-for-extra-towels/maya-bg.png",
"audioUrl": "/dialogue/at-a-hotel/asking-for-extra-towels/audio/maya-01.mp3"
},
{
"id": 2,
"speaker": "Ben",
"text": "Hi. Can I have two extra towels, please?",
"translation": "Chào bạn. Tôi có thể xin thêm hai chiếc khăn được không?",
"practicePriority": "veryImportant",
"scene": "/dialogue/at-a-hotel/asking-for-extra-towels/ben-bg.png",
"audioUrl": "/dialogue/at-a-hotel/asking-for-extra-towels/audio/ben-01.mp3"
},
{
"id": 3,
"speaker": "Maya",
"text": "Of course. What is your room number?",
"translation": "Tất nhiên. Số phòng của bạn là bao nhiêu?",
"practicePriority": "important",
"scene": "/dialogue/at-a-hotel/asking-for-extra-towels/maya-bg.png",
"audioUrl": "/dialogue/at-a-hotel/asking-for-extra-towels/audio/maya-02.mp3"
},
{
"id": 4,
"speaker": "Ben",
"text": "I'm in room 204.",
"translation": "Tôi ở phòng 204.",
"practicePriority": "important",
"scene": "/dialogue/at-a-hotel/asking-for-extra-towels/ben-bg.png",
"audioUrl": "/dialogue/at-a-hotel/asking-for-extra-towels/audio/ben-02.mp3"
},
{
"id": 5,
"speaker": "Maya",
"text": "Thank you. We'll bring the towels to your room.",
"translation": "Cảm ơn bạn. Chúng tôi sẽ mang khăn đến phòng của bạn.",
"practicePriority": "important",
"scene": "/dialogue/at-a-hotel/asking-for-extra-towels/maya-bg.png",
"audioUrl": "/dialogue/at-a-hotel/asking-for-extra-towels/audio/maya-03.mp3"
},
{
"id": 6,
"speaker": "Ben",
"text": "Great. How long will it take?",
"translation": "Tuyệt. Sẽ mất bao lâu?",
"practicePriority": "important",
"scene": "/dialogue/at-a-hotel/asking-for-extra-towels/ben-bg.png",
"audioUrl": "/dialogue/at-a-hotel/asking-for-extra-towels/audio/ben-03.mp3"
},
{
"id": 7,
"speaker": "Maya",
"text": "About ten minutes.",
"translation": "Khoảng mười phút.",
"practicePriority": "simple",
"scene": "/dialogue/at-a-hotel/asking-for-extra-towels/maya-bg.png",
"audioUrl": "/dialogue/at-a-hotel/asking-for-extra-towels/audio/maya-04.mp3"
},
{
"id": 8,
"speaker": "Ben",
"text": "Okay. Can you leave them at the door, please?",

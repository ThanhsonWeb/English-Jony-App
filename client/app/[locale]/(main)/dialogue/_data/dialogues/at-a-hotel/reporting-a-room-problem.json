},
"dialogue": [
{
"id": 1,
"speaker": "Maya",
"text": "Front desk. How can I help you?",
"translation": "Lễ tân đây. Tôi có thể giúp gì cho bạn?",
"practicePriority": "simple",
"scene": "/dialogue/at-a-hotel/reporting-a-room-problem/bg.png",
"audioUrl": "/dialogue/at-a-hotel/reporting-a-room-problem/audio/maya-01.mp3"
},
{
"id": 2,
"speaker": "Ben",
"text": "Hi. The TV in my room isn't working.",
"translation": "Chào bạn. TV trong phòng tôi không hoạt động.",
"practicePriority": "veryImportant",
"scene": "/dialogue/at-a-hotel/reporting-a-room-problem/bg.png",
"audioUrl": "/dialogue/at-a-hotel/reporting-a-room-problem/audio/ben-01.mp3"
},
{
"id": 3,
"speaker": "Maya",
"text": "I'm sorry about that. What is your room number?",
"translation": "Tôi rất tiếc về việc đó. Số phòng của bạn là bao nhiêu?",
"practicePriority": "important",
"scene": "/dialogue/at-a-hotel/reporting-a-room-problem/bg.png",
"audioUrl": "/dialogue/at-a-hotel/reporting-a-room-problem/audio/maya-02.mp3"
},
{
"id": 4,
"speaker": "Ben",
"text": "I'm in room 204.",
"translation": "Tôi ở phòng 204.",
"practicePriority": "important",
"scene": "/dialogue/at-a-hotel/reporting-a-room-problem/bg.png",
"audioUrl": "/dialogue/at-a-hotel/reporting-a-room-problem/audio/ben-02.mp3"
},
{
"id": 5,
"speaker": "Maya",
"text": "Can you see anything on the screen?",
"translation": "Bạn có thấy gì trên màn hình không?",
"practicePriority": "important",
"scene": "/dialogue/at-a-hotel/reporting-a-room-problem/bg.png",
"audioUrl": "/dialogue/at-a-hotel/reporting-a-room-problem/audio/maya-03.mp3"
},
{
"id": 6,
"speaker": "Ben",
"text": "No. The screen is black.",
"translation": "Không. Màn hình màu đen.",
"practicePriority": "important",
"scene": "/dialogue/at-a-hotel/reporting-a-room-problem/bg.png",
"audioUrl": "/dialogue/at-a-hotel/reporting-a-room-problem/audio/ben-03.mp3"
},
{
"id": 7,
"speaker": "Maya",
"text": "Okay. I'll send someone to check it.",
"translation": "Được rồi. Tôi sẽ cử người đến kiểm tra.",
"practicePriority": "important",
"scene": "/dialogue/at-a-hotel/reporting-a-room-problem/bg.png",
"audioUrl": "/dialogue/at-a-hotel/reporting-a-room-problem/audio/maya-04.mp3"
},
{
"id": 8,
"speaker": "Ben",
"text": "Thank you. How long will it take?",
"translation": "Cảm ơn. Sẽ mất bao lâu?",
"practicePriority": "important",
"scene": "/dialogue/at-a-hotel/reporting-a-room-problem/bg.png",
"audioUrl": "/dialogue/at-a-hotel/reporting-a-room-problem/audio/ben-04.mp3"
},
{
"id": 9,
"speaker": "Maya",
"text": "About fifteen minutes.",
"translation": "Khoảng mười lăm phút.",
"practicePriority": "simple",
"scene": "/dialogue/at-a-hotel/reporting-a-room-problem/bg.png",
"audioUrl": "/dialogue/at-a-hotel/reporting-a-room-problem/audio/maya-05.mp3"
},
{
"id": 10,
"speaker": "Ben",
"text": "That's fine. Thank you for your help.",
"translation": "Được thôi. Cảm ơn bạn đã giúp đỡ.",
"practicePriority": "simple",
"scene": "/dialogue/at-a-hotel/reporting-a-room-problem/bg.png",
"audioUrl": "/dialogue/at-a-hotel/reporting-a-room-problem/audio/ben-05.mp3"
}

  "grammarNotes": [
    {
      "title": "Will – nói về điều sẽ xảy ra",
      "explanation": "Dùng will + động từ nguyên mẫu để nói về điều bạn nghĩ sẽ xảy ra trong tương lai. Ví dụ: “Mom will be angry.” nghĩa là Noah nghĩ mẹ sẽ giận.",
      "localized": {
        "title": {
          "vi": "Will – nói về điều sẽ xảy ra",
          "en": "Will – talking about the future"
        },
        "explanation": {
          "vi": "Dùng will + động từ nguyên mẫu để nói về điều bạn nghĩ sẽ xảy ra trong tương lai. Ví dụ: “Mom will be angry.” nghĩa là Noah nghĩ mẹ sẽ giận.",
          "en": "Use will + the base form of a verb to talk about something you think will happen in the future. For example, “Mom will be angry” shows that Noah thinks his mom will get angry."
        }
      },
      "example": "Mom will be angry."
    },
    {
      "title": "Was – nói về trạng thái trong quá khứ",
      "explanation": "Was là dạng quá khứ của am và is. Dùng was để nói về nơi bạn đã ở hoặc trạng thái của bạn trước đó. Ví dụ: “I was outside.” nghĩa là trước đó tôi đã ở bên ngoài.",
      "localized": {
        "title": {
          "vi": "Was – nói về trạng thái trong quá khứ",
          "en": "Was – talking about the past"
        },
        "explanation": {
          "vi": "Was là dạng quá khứ của am và is. Dùng was để nói về nơi bạn đã ở hoặc trạng thái của bạn trước đó. Ví dụ: “I was outside.” nghĩa là trước đó tôi đã ở bên ngoài.",
          "en": "Was is the past form of am and is. Use was to talk about where you were or how you felt before. For example, “I was outside” tells us where the speaker was earlier."
        }
      },
      "example": "I was outside, Mom."
    }
  ]

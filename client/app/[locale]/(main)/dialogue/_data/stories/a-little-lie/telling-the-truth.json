  "grammarNotes": [
    {
      "title": "Can I – xin phép hoặc ngỏ ý giúp đỡ",
      "explanation": "Dùng Can I + động từ nguyên mẫu để hỏi xem mình có thể làm điều gì không. Khi muốn giúp ai đó, bạn có thể nói “Can I help you?” để ngỏ ý giúp đỡ một cách lịch sự.",
      "localized": {
        "title": {
          "vi": "Can I – xin phép hoặc ngỏ ý giúp đỡ",
          "en": "Can I – asking permission or offering help"
        },
        "explanation": {
          "vi": "Dùng Can I + động từ nguyên mẫu để hỏi xem mình có thể làm điều gì không. Khi muốn giúp ai đó, bạn có thể nói “Can I help you?” để ngỏ ý giúp đỡ một cách lịch sự.",
          "en": "Use Can I + the base form of a verb to ask if you can do something. When you want to help someone, you can say “Can I help you?” to offer help politely."
        }
      },
      "example": "Can I help you with the window?"
    },
    {
      "title": "Will – nói về quyết định trong tương lai",
      "explanation": "Dùng will + động từ nguyên mẫu để nói về điều bạn quyết định hoặc hứa sẽ làm trong tương lai. Ví dụ: “I will tell the truth next time.” nghĩa là lần sau Noah sẽ nói thật.",
      "localized": {
        "title": {
          "vi": "Will – nói về quyết định trong tương lai",
          "en": "Will – talking about future decisions"
        },
        "explanation": {
          "vi": "Dùng will + động từ nguyên mẫu để nói về điều bạn quyết định hoặc hứa sẽ làm trong tương lai. Ví dụ: “I will tell the truth next time.” nghĩa là lần sau Noah sẽ nói thật.",
          "en": "Use will + the base form of a verb to talk about a decision or promise for the future. For example, “I will tell the truth next time” shows Noah's promise to be honest."
        }
      },
      "example": "I will tell the truth next time."
    }
  ]

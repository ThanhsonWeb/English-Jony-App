      "scene": "/stories/a-little-lie/telling-the-truth/bg.png",
      "audioUrl": "/stories/a-little-lie/telling-the-truth/audio/mom-03.mp3"
    },
    {
      "id": 8,
      "speaker": "Mom",
      "text": "But the truth is important.",
      "translation": "Nhưng sự thật rất quan trọng.",
      "practicePriority": "important",
      "scene": "/stories/a-little-lie/telling-the-truth/bg.png",
      "audioUrl": "/stories/a-little-lie/telling-the-truth/audio/mom-04.mp3"
    },
    {
      "id": 9,
      "speaker": "Noah",
      "text": "Can I help you with the window?",
      "translation": "Con có thể giúp mẹ xử lý chuyện cửa sổ không?",
      "practicePriority": "important",
      "scene": "/stories/a-little-lie/telling-the-truth/bg.png",
      "audioUrl": "/stories/a-little-lie/telling-the-truth/audio/noah-05.mp3"
    },
    {
      "id": 10,
      "speaker": "Mom",
      "text": "Yes. We can fix it together.",
      "translation": "Được chứ. Mẹ con mình có thể cùng nhau sửa nó.",
      "practicePriority": "important",
      "scene": "/stories/a-little-lie/telling-the-truth/bg.png",
      "audioUrl": "/stories/a-little-lie/telling-the-truth/audio/mom-05.mp3"
    },
    {
      "id": 11,
      "speaker": "Noah",
      "text": "I will tell the truth next time.",
      "translation": "Lần sau con sẽ nói thật.",
      "practicePriority": "veryImportant",
      "scene": "/stories/a-little-lie/telling-the-truth/bg.png",
      "audioUrl": "/stories/a-little-lie/telling-the-truth/audio/noah-06.mp3"
    },
    {
      "id": 12,
      "speaker": "Mom",
      "text": "I'm proud of you, Noah.",
      "translation": "Mẹ tự hào về con, Noah.",

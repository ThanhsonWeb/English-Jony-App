  },
  "dialogue": [
    {
      "id": 1,
      "speaker": "Noah",
      "text": "Mom, I broke the window.",
      "translation": "Mẹ ơi, con đã làm vỡ cửa sổ.",
      "practicePriority": "veryImportant",
      "scene": "/stories/a-little-lie/telling-the-truth/bg.png",
      "audioUrl": "/stories/a-little-lie/telling-the-truth/audio/noah-01.mp3"
    },
    {
      "id": 2,
      "speaker": "Noah",
      "text": "My ball hit it. I'm very sorry.",
      "translation": "Quả bóng của con đã đập vào nó. Con thật sự xin lỗi.",
      "practicePriority": "important",
      "scene": "/stories/a-little-lie/telling-the-truth/bg.png",
      "audioUrl": "/stories/a-little-lie/telling-the-truth/audio/noah-02.mp3"
    },
    {
      "id": 3,
      "speaker": "Noah",
      "text": "I was scared, so I lied.",
      "translation": "Con đã sợ, nên con nói dối.",
      "practicePriority": "important",
      "scene": "/stories/a-little-lie/telling-the-truth/bg.png",
      "audioUrl": "/stories/a-little-lie/telling-the-truth/audio/noah-03.mp3"
    },
    {
      "id": 4,
      "speaker": "Mom",
      "text": "Thank you for telling me the truth.",
      "translation": "Cảm ơn con vì đã nói thật với mẹ.",
      "practicePriority": "important",
      "scene": "/stories/a-little-lie/telling-the-truth/bg.png",
      "audioUrl": "/stories/a-little-lie/telling-the-truth/audio/mom-01.mp3"
    },
    {
      "id": 5,
      "speaker": "Mom",
      "text": "I was worried about you.",
      "translation": "Mẹ đã lo lắng cho con.",
      "practicePriority": "simple",
      "scene": "/stories/a-little-lie/telling-the-truth/bg.png",
      "audioUrl": "/stories/a-little-lie/telling-the-truth/audio/mom-02.mp3"
    },
    {
      "id": 6,
      "speaker": "Noah",
      "text": "Are you still angry with me?",
      "translation": "Mẹ vẫn còn giận con sao?",
      "practicePriority": "important",
      "scene": "/stories/a-little-lie/telling-the-truth/bg.png",
      "audioUrl": "/stories/a-little-lie/telling-the-truth/audio/noah-04.mp3"
    },
    {
      "id": 7,
      "speaker": "Mom",
      "text": "I am sad that you lied.",
      "translation": "Mẹ buồn vì con đã nói dối.",

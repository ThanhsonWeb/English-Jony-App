    "localized": {
      "courseTitle": {
        "vi": "Lời nói dối nhỏ",
        "en": "A Little Lie"
      },
      "courseDescription": {
        "vi": "Một cậu bé học được rằng nói sự thật và nhận lỗi quan trọng hơn việc che giấu sai lầm.",
        "en": "A boy learns that telling the truth and admitting mistakes is more important than hiding them."
      },
      "title": {
        "vi": "Nói ra sự thật",
        "en": "Telling the Truth"
      },
      "description": {
        "vi": "Noah thú nhận và xin lỗi mẹ. Cậu hiểu rằng trung thực quan trọng hơn che giấu sai lầm.",
        "en": "Noah admits his mistake and apologizes to his mom. He learns that being honest is more important than hiding mistakes."
      }
    },
    "level": "a1",
    "a1ContentRulesVersion": 2,
    "teachesContractions": [],
    "situation": "Noah thú nhận và xin lỗi mẹ. Cậu hiểu rằng trung thực quan trọng hơn che giấu sai lầm.",
    "scene": "/stories/a-little-lie/telling-the-truth/bg.png",

    "localized": {
      "courseTitle": {
        "vi": "Lời nói dối nhỏ",
        "en": "A Little Lie"
      },
      "courseDescription": {
        "vi": "Một cậu bé học được rằng nói sự thật và nhận lỗi quan trọng hơn việc che giấu sai lầm.",
        "en": "A boy learns that telling the truth and admitting mistakes is more important than hiding them."
      },
      "title": {
        "vi": "Lời nói dối nhỏ",
        "en": "A Little Lie"
      },
      "description": {
        "vi": "Mẹ hỏi về cửa sổ bị vỡ. Vì sợ bị mắng, Noah nói dối rằng mình không biết.",
        "en": "Mom asks about the broken window. Afraid of getting in trouble, Noah lies and says he does not know what happened."
      }
    },
    "level": "a1",
    "a1ContentRulesVersion": 2,
    "teachesContractions": [],
    "situation": "Mẹ hỏi về cửa sổ bị vỡ. Vì sợ bị mắng, Noah nói dối rằng mình không biết.",

  },
  "dialogue": [
    {
      "id": 1,
      "speaker": "Mom",
      "text": "Noah, the window is broken.",
      "translation": "Noah, cửa sổ bị vỡ rồi.",
      "practicePriority": "simple",
      "scene": "/stories/a-little-lie/a-little-lie/bg.png",
      "audioUrl": "/stories/a-little-lie/a-little-lie/audio/mom-01.mp3"
    },
    {
      "id": 2,
      "speaker": "Mom",
      "text": "Do you know what happened?",
      "translation": "Con có biết chuyện gì đã xảy ra không?",
      "practicePriority": "important",
      "scene": "/stories/a-little-lie/a-little-lie/bg.png",
      "audioUrl": "/stories/a-little-lie/a-little-lie/audio/mom-02.mp3"
    },
    {
      "id": 3,
      "speaker": "Noah",
      "text": "No, Mom. I don't know what happened.",
      "translation": "Không, mẹ ạ. Con không biết chuyện gì đã xảy ra.",
      "practicePriority": "veryImportant",
      "scene": "/stories/a-little-lie/a-little-lie/bg.png",
      "audioUrl": "/stories/a-little-lie/a-little-lie/audio/noah-01.mp3"
    },
    {
      "id": 4,
      "speaker": "Mom",
      "text": "But you said you made a mistake.",
      "translation": "Nhưng con đã nói là con mắc lỗi mà.",
      "practicePriority": "important",
      "scene": "/stories/a-little-lie/a-little-lie/bg.png",
      "audioUrl": "/stories/a-little-lie/a-little-lie/audio/mom-03.mp3"
    },
    {
      "id": 5,
      "speaker": "Noah",
      "text": "I was talking about my game.",
      "translation": "Con đang nói về trò chơi của con thôi.",
      "practicePriority": "important",
      "scene": "/stories/a-little-lie/a-little-lie/bg.png",
      "audioUrl": "/stories/a-little-lie/a-little-lie/audio/noah-02.mp3"
    },
    {
      "id": 6,
      "speaker": "Mom",
      "text": "Did your ball hit the window?",
      "translation": "Quả bóng của con có đập vào cửa sổ không?",
      "practicePriority": "important",
      "scene": "/stories/a-little-lie/a-little-lie/bg.png",
      "audioUrl": "/stories/a-little-lie/a-little-lie/audio/mom-04.mp3"
    },
    {
      "id": 7,
      "speaker": "Noah",
      "text": "No, it did not. I was just playing.",
      "translation": "Không ạ, không có đâu. Con chỉ đang chơi thôi.",
      "practicePriority": "veryImportant",
      "scene": "/stories/a-little-lie/a-little-lie/bg.png",
      "audioUrl": "/stories/a-little-lie/a-little-lie/audio/noah-03.mp3"
    },
    {
      "id": 8,
      "speaker": "Mom",
      "text": "Are you telling me the truth?",
      "translation": "Con có đang nói thật với mẹ không?",
      "practicePriority": "important",
      "scene": "/stories/a-little-lie/a-little-lie/bg.png",
      "audioUrl": "/stories/a-little-lie/a-little-lie/audio/mom-05.mp3"
    },
    {
      "id": 9,
      "speaker": "Noah",
      "text": "Yes, Mom. I am sure.",
      "translation": "Có ạ, mẹ. Con chắc chắn.",
      "practicePriority": "simple",
      "scene": "/stories/a-little-lie/a-little-lie/bg.png",
      "audioUrl": "/stories/a-little-lie/a-little-lie/audio/noah-04.mp3"
    },
    {
      "id": 10,
      "speaker": "Mom",
      "text": "You can tell me if something is wrong.",
      "translation": "Con có thể nói với mẹ nếu có chuyện gì không ổn.",
      "practicePriority": "important",
      "scene": "/stories/a-little-lie/a-little-lie/bg.png",
      "audioUrl": "/stories/a-little-lie/a-little-lie/audio/mom-06.mp3"
    },
    {
      "id": 11,
      "speaker": "Noah",
      "text": "I know, Mom. I'm just scared.",
      "translation": "Con biết, mẹ ạ. Con chỉ sợ thôi.",
      "practicePriority": "simple",
      "scene": "/stories/a-little-lie/a-little-lie/bg.png",
      "audioUrl": "/stories/a-little-lie/a-little-lie/audio/noah-05.mp3"
    },
    {
      "id": 12,
      "speaker": "Mom",
      "text": "Okay. We can talk later.",
      "translation": "Được rồi. Mẹ con mình có thể nói chuyện sau.",
      "practicePriority": "important",
      "scene": "/stories/a-little-lie/a-little-lie/bg.png",
      "audioUrl": "/stories/a-little-lie/a-little-lie/audio/mom-07.mp3"
    }

  "grammarNotes": [
    {
      "title": "Did – hỏi về việc đã xảy ra",
      "explanation": "Dùng Did + chủ ngữ + động từ nguyên mẫu để hỏi một việc có xảy ra trong quá khứ không. Ví dụ: “Did your ball hit the window?” nghĩa là mẹ muốn biết quả bóng có đập vào cửa sổ trước đó không.",
      "localized": {
        "title": {
          "vi": "Did – hỏi về việc đã xảy ra",
          "en": "Did – asking about the past"
        },
        "explanation": {
          "vi": "Dùng Did + chủ ngữ + động từ nguyên mẫu để hỏi một việc có xảy ra trong quá khứ không. Ví dụ: “Did your ball hit the window?” nghĩa là mẹ muốn biết quả bóng có đập vào cửa sổ trước đó không.",
          "en": "Use Did + subject + base verb to ask whether something happened in the past. For example, “Did your ball hit the window?” asks if the ball hit the window earlier."
        }
      },
      "example": "Did your ball hit the window?"
    },
    {
      "title": "Can – cho phép hoặc khuyến khích",
      "explanation": "Dùng can + động từ nguyên mẫu để nói ai đó có thể làm điều gì. Trong câu “You can tell me if something is wrong.”, mẹ dùng can để khuyến khích Noah chia sẻ mà không gây áp lực.",
      "localized": {
        "title": {
          "vi": "Can – cho phép hoặc khuyến khích",
          "en": "Can – giving permission or encouragement"
        },
        "explanation": {
          "vi": "Dùng can + động từ nguyên mẫu để nói ai đó có thể làm điều gì. Trong câu “You can tell me if something is wrong.”, mẹ dùng can để khuyến khích Noah chia sẻ mà không gây áp lực.",
          "en": "Use can + the base form of a verb to say someone is allowed or able to do something. In “You can tell me if something is wrong,” Mom uses can to encourage Noah to share without pressure."
        }
      },
      "example": "You can tell me if something is wrong."
    }
  ]

{
  "metadata": {
    "courseId": "a-small-surprise",
    "dialogueId": "the-broken-cake",
    "contextualGlossaryVersion": 1,
    "title": "Chiếc bánh bị hỏng",
    "localizationVersion": 1,
    "localized": {
      "courseTitle": {
        "vi": "Một bất ngờ nhỏ",
        "en": "A Small Surprise"
      },
      "courseDescription": {
        "vi": "Noah và mẹ chuẩn bị một bất ngờ cho sinh nhật của bố.",
        "en": "Noah and Mom prepare a birthday surprise for Dad."
      },
      "title": {
        "vi": "Chiếc bánh bị hỏng",
        "en": "The Broken Cake"
      },
      "description": {
        "vi": "While preparing the birthday surprise, Noah accidentally breaks the cake. He feels sad and worries that Dad's birthday is ruined. Mom comforts him.",
        "en": "While preparing the birthday surprise, Noah accidentally breaks the cake. He feels sad and worries that Dad's birthday is ruined. Mom comforts him."
      }
    },
    "level": "a1",
    "a1ContentRulesVersion": 2,
    "teachesContractions": [],
    "situation": "While preparing the birthday surprise, Noah accidentally breaks the cake. He feels sad and worries that Dad's birthday is ruined. Mom comforts him.",
    "scene": "/stories/a-small-surprise/the-broken-cake/bg.webp",
    "thumbnail": "/stories/a-small-surprise/thumbnails/the-broken-cake.webp"
  },
  "dialogue": [
    {
      "id": 1,
      "speaker": "Noah",
      "text": "Mom, I dropped the cake!",
      "translation": "Mẹ ơi, con làm rơi chiếc bánh rồi!",
      "practicePriority": "veryImportant",
      "scene": "/stories/a-small-surprise/the-broken-cake/bg.webp",
      "audioUrl": "/stories/a-small-surprise/the-broken-cake/audio/noah-01.mp3"
    },
    {
      "id": 2,
      "speaker": "Mom",
      "text": "Oh no! Are you okay?",
      "translation": "Ôi không! Con có sao không?",
      "practicePriority": "simple",
      "scene": "/stories/a-small-surprise/the-broken-cake/bg.webp",
      "audioUrl": "/stories/a-small-surprise/the-broken-cake/audio/mom-01.mp3"
    },
    {
      "id": 3,
      "speaker": "Noah",
      "text": "Yes, but the cake is broken.",
      "translation": "Con không sao, nhưng chiếc bánh bị hỏng rồi.",
      "practicePriority": "important",
      "scene": "/stories/a-small-surprise/the-broken-cake/bg.webp",
      "audioUrl": "/stories/a-small-surprise/the-broken-cake/audio/noah-02.mp3"
    },
    {
      "id": 4,
      "speaker": "Noah",
      "text": "It was a surprise for Dad.",
      "translation": "Đó là món quà bất ngờ dành cho bố mà.",
      "practicePriority": "important",
      "scene": "/stories/a-small-surprise/the-broken-cake/bg.webp",
      "audioUrl": "/stories/a-small-surprise/the-broken-cake/audio/noah-03.mp3"
    },
    {
      "id": 5,
      "speaker": "Mom",
      "text": "I know, Noah. It was an accident.",
      "translation": "Mẹ biết, Noah. Con chỉ vô tình thôi.",
      "practicePriority": "important",
      "scene": "/stories/a-small-surprise/the-broken-cake/bg.webp",
      "audioUrl": "/stories/a-small-surprise/the-broken-cake/audio/mom-02.mp3"
    },
    {
      "id": 6,
      "speaker": "Noah",
      "text": "I'm sorry. I feel so sad.",
      "translation": "Con xin lỗi. Con buồn quá.",
      "practicePriority": "veryImportant",
      "scene": "/stories/a-small-surprise/the-broken-cake/bg.webp",
      "audioUrl": "/stories/a-small-surprise/the-broken-cake/audio/noah-04.mp3"
    },
    {
      "id": 7,
      "speaker": "Mom",
      "text": "It's okay. We can make another cake.",
      "translation": "Không sao đâu. Mẹ con mình có thể làm một chiếc bánh khác.",
      "practicePriority": "veryImportant",
      "scene": "/stories/a-small-surprise/the-broken-cake/bg.webp",
      "audioUrl": "/stories/a-small-surprise/the-broken-cake/audio/mom-03.mp3"
    },
    {
      "id": 8,
      "speaker": "Noah",
      "text": "Really? But his birthday is tomorrow!",
      "translation": "Thật ạ? Nhưng mai là sinh nhật bố rồi!",
      "practicePriority": "important",
      "scene": "/stories/a-small-surprise/the-broken-cake/bg.webp",
      "audioUrl": "/stories/a-small-surprise/the-broken-cake/audio/noah-05.mp3"
    },
    {
      "id": 9,
      "speaker": "Mom",
      "text": "We still have time. Dad is at work.",
      "translation": "Mình vẫn còn thời gian. Bố đang ở chỗ làm.",
      "practicePriority": "important",
      "scene": "/stories/a-small-surprise/the-broken-cake/bg.webp",
      "audioUrl": "/stories/a-small-surprise/the-broken-cake/audio/mom-04.mp3"
    },
    {
      "id": 10,
      "speaker": "Noah",
      "text": "Do we have enough chocolate?",
      "translation": "Nhà mình có đủ sô-cô-la không mẹ?",
      "practicePriority": "important",
      "scene": "/stories/a-small-surprise/the-broken-cake/bg.webp",
      "audioUrl": "/stories/a-small-surprise/the-broken-cake/audio/noah-06.mp3"
    },
    {
      "id": 11,
      "speaker": "Mom",
      "text": "Yes, we have some left.",
      "translation": "Có chứ, mình vẫn còn một ít.",
      "practicePriority": "simple",
      "scene": "/stories/a-small-surprise/the-broken-cake/bg.webp",
      "audioUrl": "/stories/a-small-surprise/the-broken-cake/audio/mom-05.mp3"
    },
    {
      "id": 12,
      "speaker": "Noah",
      "text": "Can we make it together again?",
      "translation": "Mẹ con mình có thể cùng làm lại được không ạ?",
      "practicePriority": "important",
      "scene": "/stories/a-small-surprise/the-broken-cake/bg.webp",
      "audioUrl": "/stories/a-small-surprise/the-broken-cake/audio/noah-07.mp3"
    },
    {
      "id": 13,
      "speaker": "Mom",
      "text": "Of course! We can make a small one.",
      "translation": "Tất nhiên rồi! Mình có thể làm một chiếc bánh nhỏ.",
      "practicePriority": "important",
      "scene": "/stories/a-small-surprise/the-broken-cake/bg.webp",
      "audioUrl": "/stories/a-small-surprise/the-broken-cake/audio/mom-06.mp3"
    },
    {
      "id": 14,
      "speaker": "Noah",
      "text": "Thank you, Mom. I feel much better now!",
      "translation": "Con cảm ơn mẹ. Bây giờ con thấy đỡ buồn hơn nhiều rồi!",
      "practicePriority": "important",
      "scene": "/stories/a-small-surprise/the-broken-cake/bg.webp",
      "audioUrl": "/stories/a-small-surprise/the-broken-cake/audio/noah-08.mp3"
    }
  ],

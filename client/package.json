{
	"name": "client",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"predev": "npm --prefix ../server run dialogue:catalogue",
		"dev": "node ../server/scripts/run-dev-with-dialogue-catalogue.js client",
		"prebuild": "npm --prefix ../server run dialogue:catalogue",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"test:dialogue-playback-rate": "node --test app/_lib/dialogue/playbackRate.test.mjs",
		"test:wordlist-review-localization": "node --test scripts/wordlist-review-localization.test.mjs",
		"test:review-question-state": "node --test scripts/review-question-state.test.mjs",
		"audit:dictionary": "node scripts/audit-local-dictionary.mjs",
		"generate:dialogue-audio": "node --env-file=.env.local scripts/generate-dialogue-audio.mjs",
		"dialogue:build": "node --env-file=.env.local scripts/build-dialogue.mjs",

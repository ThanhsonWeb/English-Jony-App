{
	"name": "client",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"predev": "npm --prefix ../server run dialogue:catalogue",
		"dev": "node ../server/scripts/run-dev-with-dialogue-catalogue.js client",
		"prebuild": "npm --prefix ../server run dialogue:catalogue",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"test": "npm run test:unit && npm run test:integration && npm run test:app && npm run test:browser",
		"test:unit": "node scripts/tests/run-node-tests.cjs unit",
		"test:integration": "node scripts/tests/run-node-tests.cjs integration",
		"test:app": "node scripts/tests/run-node-tests.cjs app",
		"test:browser": "node scripts/tests/browser/run-all.cjs",
		"test:dialogue-playback-rate": "node --test app/_lib/dialogue/playbackRate.test.mjs",
		"test:wordlist-review-localization": "node --test scripts/tests/integration/wordlist-review-localization.test.mjs",
		"test:review-question-state": "node --test scripts/tests/unit/review-question-state.test.mjs",
		"audit:dictionary": "node scripts/audit-local-dictionary.mjs",
		"generate:dialogue-audio": "node --env-file=.env.local scripts/generate-dialogue-audio.mjs",
		"dialogue:build": "node --env-file=.env.local scripts/build-dialogue.mjs",
		"dialogue:thumbnails:prepare": "node scripts/prepare-dialogue-thumbnails.mjs",
		"create:dialogue": "node scripts/create-dialogue.mjs",
		"glossary:prepare": "node scripts/contextual-glossary.mjs prepare",
		"glossary:check": "node scripts/contextual-glossary.mjs check"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1",
		"lucide-react": "^1.28.0",
		"next": "16.3.8",
		"next-auth": "^4.24.15",
		"next-intl": "^4.13.7",
		"react": "19.2.4",
		"react-dom": "19.2.4"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"eslint": "^9",
		"eslint-config-next": "16.3.8",
		"tailwindcss": "^4"
	}
}

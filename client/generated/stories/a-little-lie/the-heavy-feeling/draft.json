  "grammarNotes": [
    {
      "title": "Did not – nói về điều đã không làm",
      "explanation": "Dùng did not + động từ nguyên mẫu để nói một việc đã không xảy ra trong quá khứ. Ví dụ: “I did not tell you the truth.” nghĩa là trước đó Noah đã không nói thật với mẹ.",
      "localized": {
        "title": {
          "vi": "Did not – nói về điều đã không làm",
          "en": "Did not – talking about what did not happen"
        },
        "explanation": {
          "vi": "Dùng did not + động từ nguyên mẫu để nói một việc đã không xảy ra trong quá khứ. Ví dụ: “I did not tell you the truth.” nghĩa là trước đó Noah đã không nói thật với mẹ.",
          "en": "Use did not + the base form of a verb to say something did not happen in the past. For example, “I did not tell you the truth” means Noah did not tell Mom the truth earlier."
        }
      },
      "example": "I did not tell you the truth."
    },
    {
      "title": "Want to – nói về điều mình muốn làm",
      "explanation": "Dùng want to + động từ nguyên mẫu để nói về điều bạn muốn làm. Ví dụ: “I want to tell you everything.” nghĩa là Noah muốn kể hết mọi chuyện cho mẹ.",
      "localized": {
        "title": {
          "vi": "Want to – nói về điều mình muốn làm",
          "en": "Want to – talking about what you want to do"
        },
        "explanation": {
          "vi": "Dùng want to + động từ nguyên mẫu để nói về điều bạn muốn làm. Ví dụ: “I want to tell you everything.” nghĩa là Noah muốn kể hết mọi chuyện cho mẹ.",
          "en": "Use want to + the base form of a verb to talk about something you want to do. For example, “I want to tell you everything” means Noah wants to share the whole story with Mom."
        }
      },
      "example": "I want to tell you everything."
    }
  ]

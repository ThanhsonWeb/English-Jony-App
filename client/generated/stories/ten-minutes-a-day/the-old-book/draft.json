  "dialogue": [
    {
      "id": 1,
      "speaker": "Mr. Daniel",
      "text": "I have a book for each of you.",
      "translation": "Thầy có một cuốn sách cho mỗi em.",
      "practicePriority": "important",
      "scene": "/dialogue/ten-minutes-a-day/the-old-book/bg.png",
      "audioUrl": "/dialogue/ten-minutes-a-day/the-old-book/audio/mr-daniel-01.mp3"
    },
    {
      "id": 2,
      "speaker": "Ryan",
      "text": "An English book? It looks old.",
      "translation": "Một cuốn sách tiếng Anh à? Nó trông cũ quá.",
      "practicePriority": "simple",
      "scene": "/dialogue/ten-minutes-a-day/the-old-book/bg.png",
      "audioUrl": "/dialogue/ten-minutes-a-day/the-old-book/audio/ryan-01.mp3"
    },
    {
      "id": 3,
      "speaker": "Leo",
      "text": "What should we do with it?",
      "translation": "Chúng em nên làm gì với nó ạ?",
      "practicePriority": "important",
      "scene": "/dialogue/ten-minutes-a-day/the-old-book/bg.png",
      "audioUrl": "/dialogue/ten-minutes-a-day/the-old-book/audio/leo-01.mp3"
    },
    {
      "id": 4,
      "speaker": "Mr. Daniel",
      "text": "Read it for ten minutes every day.",
      "translation": "Hãy đọc nó trong mười phút mỗi ngày.",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/ten-minutes-a-day/the-old-book/bg.png",
      "audioUrl": "/dialogue/ten-minutes-a-day/the-old-book/audio/mr-daniel-02.mp3"
    },
    {
      "id": 5,
      "speaker": "Ryan",
      "text": "Only ten minutes?",
      "translation": "Chỉ mười phút thôi ạ?",
      "practicePriority": "simple",
      "scene": "/dialogue/ten-minutes-a-day/the-old-book/bg.png",
      "audioUrl": "/dialogue/ten-minutes-a-day/the-old-book/audio/ryan-02.mp3"
    },
    {
      "id": 6,
      "speaker": "Mr. Daniel",
      "text": "Yes. Ten minutes is enough to start.",
      "translation": "Đúng vậy. Mười phút là đủ để bắt đầu.",
      "practicePriority": "important",
      "scene": "/dialogue/ten-minutes-a-day/the-old-book/bg.png",
      "audioUrl": "/dialogue/ten-minutes-a-day/the-old-book/audio/mr-daniel-03.mp3"
    },
    {
      "id": 7,
      "speaker": "Leo",
      "text": "I can do that after dinner.",
      "translation": "Em có thể làm vậy sau bữa tối.",
      "practicePriority": "important",
      "scene": "/dialogue/ten-minutes-a-day/the-old-book/bg.png",
      "audioUrl": "/dialogue/ten-minutes-a-day/the-old-book/audio/leo-02.mp3"
    },
    {
      "id": 8,
      "speaker": "Ryan",
      "text": "I get bored when I read.",
      "translation": "Em thấy chán khi đọc sách.",
      "practicePriority": "simple",
      "scene": "/dialogue/ten-minutes-a-day/the-old-book/bg.png",
      "audioUrl": "/dialogue/ten-minutes-a-day/the-old-book/audio/ryan-03.mp3"
    },
    {
      "id": 9,
      "speaker": "Mr. Daniel",
      "text": "Do not worry about reading a lot. Just read a little every day.",
      "translation": "Đừng lo về việc phải đọc nhiều. Chỉ cần đọc một chút mỗi ngày.",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/ten-minutes-a-day/the-old-book/bg.png",
      "audioUrl": "/dialogue/ten-minutes-a-day/the-old-book/audio/mr-daniel-04.mp3"
    },
    {
      "id": 10,
      "speaker": "Ryan",
      "text": "What if I miss a day?",
      "translation": "Nếu em bỏ lỡ một ngày thì sao ạ?",
      "practicePriority": "important",
      "scene": "/dialogue/ten-minutes-a-day/the-old-book/bg.png",
      "audioUrl": "/dialogue/ten-minutes-a-day/the-old-book/audio/ryan-04.mp3"
    },
    {
      "id": 11,
      "speaker": "Mr. Daniel",
      "text": "Start again the next day. The important thing is to continue.",
      "translation": "Hãy bắt đầu lại vào ngày hôm sau. Điều quan trọng là tiếp tục.",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/ten-minutes-a-day/the-old-book/bg.png",
      "audioUrl": "/dialogue/ten-minutes-a-day/the-old-book/audio/mr-daniel-05.mp3"
    }
  ],

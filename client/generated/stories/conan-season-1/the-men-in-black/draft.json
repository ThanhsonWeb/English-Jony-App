  "dialogue": [
    {
      "id": 1,
      "speaker": "Shinichi",
      "text": "Those two men are here. What are they doing?",
      "translation": "Hai người đàn ông đó đang ở đây. Họ đang làm gì vậy?",
      "practicePriority": "simple",
      "scene": "/stories/conan-season-1/the-men-in-black/bg.webp",
      "audioUrl": "/stories/conan-season-1/the-men-in-black/audio/shinichi-01.mp3"
    },
    {
      "id": 2,
      "speaker": "Vodka",
      "text": "We need to go now.",
      "translation": "Chúng ta cần đi ngay.",
      "practicePriority": "important",
      "scene": "/stories/conan-season-1/the-men-in-black/bg.webp",
      "audioUrl": "/stories/conan-season-1/the-men-in-black/audio/vodka-01.mp3"
    },
    {
      "id": 3,
      "speaker": "Gin",
      "text": "Wait. Where is the big bag?",
      "translation": "Khoan. Chiếc túi lớn đâu rồi?",
      "practicePriority": "important",
      "scene": "/stories/conan-season-1/the-men-in-black/bg.webp",
      "audioUrl": "/stories/conan-season-1/the-men-in-black/audio/gin-01.mp3"
    },
    {
      "id": 4,
      "speaker": "Vodka",
      "text": "It's right here. Don't worry.",
      "translation": "Nó ở ngay đây. Đừng lo.",
      "practicePriority": "simple",
      "scene": "/stories/conan-season-1/the-men-in-black/bg.webp",
      "audioUrl": "/stories/conan-season-1/the-men-in-black/audio/vodka-02.mp3"
    },
    {
      "id": 5,
      "speaker": "Shinichi",
      "text": "Why do they have that bag?",
      "translation": "Tại sao họ có chiếc túi đó?",
      "practicePriority": "simple",
      "scene": "/stories/conan-season-1/the-men-in-black/bg.webp",
      "audioUrl": "/stories/conan-season-1/the-men-in-black/audio/shinichi-02.mp3"
    },
    {
      "id": 6,
      "speaker": "Gin",
      "text": "Stop! Who is there?",
      "translation": "Đứng lại! Ai ở đó?",
      "practicePriority": "important",
      "scene": "/stories/conan-season-1/the-men-in-black/bg.webp",
      "audioUrl": "/stories/conan-season-1/the-men-in-black/audio/gin-02.mp3"
    },
    {
      "id": 7,
      "speaker": "Shinichi",
      "text": "Oh no. They see me.",
      "translation": "Ôi không. Họ thấy mình rồi.",
      "practicePriority": "simple",
      "scene": "/stories/conan-season-1/the-men-in-black/bg.webp",
      "audioUrl": "/stories/conan-season-1/the-men-in-black/audio/shinichi-03.mp3"
    },
    {
      "id": 8,
      "speaker": "Vodka",
      "text": "It's the boy from the park.",
      "translation": "Đó là cậu nhóc ở công viên.",
      "practicePriority": "simple",
      "scene": "/stories/conan-season-1/the-men-in-black/bg.webp",
      "audioUrl": "/stories/conan-season-1/the-men-in-black/audio/vodka-03.mp3"
    },
    {
      "id": 9,
      "speaker": "Gin",
      "text": "Why are you following us?",
      "translation": "Tại sao cậu lại đi theo chúng tôi?",
      "practicePriority": "important",
      "scene": "/stories/conan-season-1/the-men-in-black/bg.webp",
      "audioUrl": "/stories/conan-season-1/the-men-in-black/audio/gin-03.mp3"
    },
    {
      "id": 10,
      "speaker": "Shinichi",
      "text": "I just want to know about the bag.",
      "translation": "Tôi chỉ muốn biết về chiếc túi.",
      "practicePriority": "important",
      "scene": "/stories/conan-season-1/the-men-in-black/bg.webp",
      "audioUrl": "/stories/conan-season-1/the-men-in-black/audio/shinichi-04.mp3"
    },
    {
      "id": 11,
      "speaker": "Gin",
      "text": "You know too much.",
      "translation": "Cậu biết quá nhiều rồi.",
      "practicePriority": "simple",
      "scene": "/stories/conan-season-1/the-men-in-black/bg.webp",
      "audioUrl": "/stories/conan-season-1/the-men-in-black/audio/gin-04.mp3"
    },
    {
      "id": 12,
      "speaker": "Shinichi",
      "text": "Please let me go. I will not tell anyone.",
      "translation": "Làm ơn thả tôi ra. Tôi sẽ không kể với ai đâu.",
      "practicePriority": "veryImportant",
      "scene": "/stories/conan-season-1/the-men-in-black/bg.webp",
      "audioUrl": "/stories/conan-season-1/the-men-in-black/audio/shinichi-05.mp3"
    },
    {
      "id": 13,
      "speaker": "Vodka",
      "text": "What do we do now?",
      "translation": "Bây giờ chúng ta làm gì?",
      "practicePriority": "simple",
      "scene": "/stories/conan-season-1/the-men-in-black/bg.webp",
      "audioUrl": "/stories/conan-season-1/the-men-in-black/audio/vodka-04.mp3"
    },
    {
      "id": 14,
      "speaker": "Gin",
      "text": "He must take this pill.",
      "translation": "Cậu ta phải uống viên thuốc này.",
      "practicePriority": "important",
      "scene": "/stories/conan-season-1/the-men-in-black/bg.webp",
      "audioUrl": "/stories/conan-season-1/the-men-in-black/audio/gin-05.mp3"
    },
    {
      "id": 15,
      "speaker": "Shinichi",
      "text": "What is it? I don't want it.",
      "translation": "Đó là gì? Tôi không muốn uống đâu.",
      "practicePriority": "important",
      "scene": "/stories/conan-season-1/the-men-in-black/bg.webp",
      "audioUrl": "/stories/conan-season-1/the-men-in-black/audio/shinichi-06.mp3"
    },
    {
      "id": 16,
      "speaker": "Shinichi",
      "text": "No! Please stop!",
      "translation": "Không! Làm ơn dừng lại!",
      "practicePriority": "simple",
      "scene": "/stories/conan-season-1/the-men-in-black/bg.webp",
      "audioUrl": "/stories/conan-season-1/the-men-in-black/audio/shinichi-07.mp3"

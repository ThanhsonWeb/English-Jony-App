  },
  "dialogue": [
    {
      "id": 1,
      "speaker": "Ben",
      "text": "We found the bread. Now we just need the orange juice.",
      "translation": "Chúng ta đã tìm thấy bánh mì rồi. Bây giờ chỉ còn cần nước cam thôi.",
      "practicePriority": "important",
      "scene": "/dialogue/grocery-store/choosing-food/bg.png",
      "audioUrl": "/dialogue/grocery-store/choosing-food/audio/ben-01.mp3"
    },
    {
      "id": 2,
      "speaker": "Emma",
      "text": "Here it is. There are two sizes.",
      "translation": "Nó ở đây này. Có hai kích cỡ.",
      "practicePriority": "simple",
      "scene": "/dialogue/grocery-store/choosing-food/bg.png",
      "audioUrl": "/dialogue/grocery-store/choosing-food/audio/emma-01.mp3"
    },
    {
      "id": 3,
      "speaker": "Ben",
      "text": "Which one should we get?",
      "translation": "Chúng ta nên lấy loại nào?",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/grocery-store/choosing-food/bg.png",
      "audioUrl": "/dialogue/grocery-store/choosing-food/audio/ben-02.mp3"
    },
    {
      "id": 4,
      "speaker": "Emma",
      "text": "Let's get the small one. We don't need much.",
      "translation": "Lấy chai nhỏ nhé. Chúng ta không cần nhiều.",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/grocery-store/choosing-food/bg.png",
      "audioUrl": "/dialogue/grocery-store/choosing-food/audio/emma-02.mp3"
    },
    {
      "id": 5,
      "speaker": "Ben",
      "text": "Okay. This bottle is cheaper too.",
      "translation": "Được. Chai này cũng rẻ hơn.",
      "practicePriority": "simple",
      "scene": "/dialogue/grocery-store/choosing-food/bg.png",
      "audioUrl": "/dialogue/grocery-store/choosing-food/audio/ben-03.mp3"
    },
    {
      "id": 6,
      "speaker": "Emma",
      "text": "What about the apples? Red or green?",
      "translation": "Còn táo thì sao? Đỏ hay xanh?",
      "practicePriority": "important",
      "scene": "/dialogue/grocery-store/choosing-food/bg.png",
      "audioUrl": "/dialogue/grocery-store/choosing-food/audio/emma-03.mp3"
    },
    {
      "id": 7,
      "speaker": "Ben",
      "text": "I like the red ones. They look fresh.",
      "translation": "Mình thích những quả màu đỏ. Trông chúng tươi.",
      "practicePriority": "important",
      "scene": "/dialogue/grocery-store/choosing-food/bg.png",
      "audioUrl": "/dialogue/grocery-store/choosing-food/audio/ben-04.mp3"
    },
    {
      "id": 8,
      "speaker": "Emma",
      "text": "How many should we get?",
      "translation": "Chúng ta nên lấy bao nhiêu quả?",
      "practicePriority": "important",
      "scene": "/dialogue/grocery-store/choosing-food/bg.png",
      "audioUrl": "/dialogue/grocery-store/choosing-food/audio/emma-04.mp3"
    },
    {
      "id": 9,
      "speaker": "Ben",
      "text": "Let's get four.",
      "translation": "Lấy bốn quả nhé.",
      "practicePriority": "simple",
      "scene": "/dialogue/grocery-store/choosing-food/bg.png",
      "audioUrl": "/dialogue/grocery-store/choosing-food/audio/ben-05.mp3"
    },
    {
      "id": 10,
      "speaker": "Emma",
      "text": "And these bananas are ripe.",
      "translation": "Và những quả chuối này đã chín.",
      "practicePriority": "simple",
      "scene": "/dialogue/grocery-store/choosing-food/bg.png",
      "audioUrl": "/dialogue/grocery-store/choosing-food/audio/emma-05.mp3"
    },
    {
      "id": 11,
      "speaker": "Ben",
      "text": "Great. I think we have everything now.",
      "translation": "Tuyệt. Mình nghĩ bây giờ chúng ta đã có đủ mọi thứ rồi.",
      "practicePriority": "simple",
      "scene": "/dialogue/grocery-store/choosing-food/bg.png",
      "audioUrl": "/dialogue/grocery-store/choosing-food/audio/ben-06.mp3"
    },
    {
      "id": 12,
      "speaker": "Emma",
      "text": "Yes. Let's go to the checkout.",
      "translation": "Ừ. Đi đến quầy thanh toán nhé.",
      "practicePriority": "important",
      "scene": "/dialogue/grocery-store/choosing-food/bg.png",
      "audioUrl": "/dialogue/grocery-store/choosing-food/audio/emma-06.mp3"
    }

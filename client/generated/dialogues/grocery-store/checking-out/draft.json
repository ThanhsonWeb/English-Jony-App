{
  "metadata": {
    "courseId": "grocery-store",
    "dialogueId": "checking-out",
    "title": "Thanh toán tại quầy",
    "level": "a1",
    "situation": "Ben và Emma mang đồ đến quầy thanh toán. Lee tính tiền và Ben hỏi về tổng số tiền và cách thanh toán.",
    "scene": "/dialogue/grocery-store/checking-out/bg.png",
    "thumbnail": "/dialogue/grocery-store/thumbnails/checking-out.png"
  },
  "dialogue": [
    {
      "id": 1,
      "speaker": "Lee",
      "text": "Hi. Did you find everything you needed?",
      "translation": "Chào bạn. Hai bạn đã tìm được mọi thứ mình cần chưa?",
      "practicePriority": "simple",
      "scene": "/dialogue/grocery-store/checking-out/bg.png",
      "audioUrl": "/dialogue/grocery-store/checking-out/audio/lee-01.mp3"
    },
    {
      "id": 2,
      "speaker": "Emma",
      "text": "Yes, we did. Thanks.",
      "translation": "Rồi, chúng tôi tìm được rồi. Cảm ơn.",
      "practicePriority": "simple",
      "scene": "/dialogue/grocery-store/checking-out/bg.png",
      "audioUrl": "/dialogue/grocery-store/checking-out/audio/emma-01.mp3"
    },
    {
      "id": 3,
      "speaker": "Ben",
      "text": "How much is it altogether?",
      "translation": "Tổng cộng là bao nhiêu tiền?",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/grocery-store/checking-out/bg.png",
      "audioUrl": "/dialogue/grocery-store/checking-out/audio/ben-01.mp3"
    },
    {
      "id": 4,
      "speaker": "Lee",
      "text": "It's eighteen dollars and fifty cents.",
      "translation": "Tổng cộng là mười tám đô la năm mươi xu.",
      "practicePriority": "important",
      "scene": "/dialogue/grocery-store/checking-out/bg.png",
      "audioUrl": "/dialogue/grocery-store/checking-out/audio/lee-02.mp3"
    },
    {
      "id": 5,
      "speaker": "Ben",
      "text": "Okay. Can I pay by card?",
      "translation": "Được. Tôi có thể thanh toán bằng thẻ không?",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/grocery-store/checking-out/bg.png",
      "audioUrl": "/dialogue/grocery-store/checking-out/audio/ben-02.mp3"
    },
    {
      "id": 6,
      "speaker": "Lee",
      "text": "Yes. We take cash and cards.",
      "translation": "Có. Chúng tôi nhận tiền mặt và thẻ.",
      "practicePriority": "important",
      "scene": "/dialogue/grocery-store/checking-out/bg.png",
      "audioUrl": "/dialogue/grocery-store/checking-out/audio/lee-03.mp3"
    },
    {
      "id": 7,
      "speaker": "Ben",
      "text": "Can I pay with my phone too?",
      "translation": "Tôi cũng có thể thanh toán bằng điện thoại không?",
      "practicePriority": "important",
      "scene": "/dialogue/grocery-store/checking-out/bg.png",
      "audioUrl": "/dialogue/grocery-store/checking-out/audio/ben-03.mp3"
    },
    {
      "id": 8,
      "speaker": "Lee",
      "text": "Yes, you can.",
      "translation": "Có, bạn có thể.",
      "practicePriority": "simple",
      "scene": "/dialogue/grocery-store/checking-out/bg.png",
      "audioUrl": "/dialogue/grocery-store/checking-out/audio/lee-04.mp3"
    },
    {
      "id": 9,
      "speaker": "Emma",
      "text": "Do we need a bag?",
      "translation": "Chúng ta có cần túi không?",
      "practicePriority": "simple",
      "scene": "/dialogue/grocery-store/checking-out/bg.png",
      "audioUrl": "/dialogue/grocery-store/checking-out/audio/emma-02.mp3"
    },
    {
      "id": 10,
      "speaker": "Ben",
      "text": "Yes. One bag is enough.",
      "translation": "Có. Một túi là đủ.",
      "practicePriority": "important",
      "scene": "/dialogue/grocery-store/checking-out/bg.png",
      "audioUrl": "/dialogue/grocery-store/checking-out/audio/ben-04.mp3"
    },
    {
      "id": 11,
      "speaker": "Lee",
      "text": "The bag is ten cents. Is that okay?",
      "translation": "Túi có giá mười xu. Như vậy có được không?",
      "practicePriority": "important",
      "scene": "/dialogue/grocery-store/checking-out/bg.png",
      "audioUrl": "/dialogue/grocery-store/checking-out/audio/lee-05.mp3"
    },
    {
      "id": 12,
      "speaker": "Ben",
      "text": "Yes, that's fine. Thank you.",
      "translation": "Vâng, được thôi. Cảm ơn.",
      "practicePriority": "simple",
      "scene": "/dialogue/grocery-store/checking-out/bg.png",
      "audioUrl": "/dialogue/grocery-store/checking-out/audio/ben-05.mp3"
    },
    {
      "id": 13,
      "speaker": "Lee",
      "text": "You're welcome. Have a nice day.",
      "translation": "Không có gì. Chúc bạn một ngày tốt lành.",
      "practicePriority": "important",
      "scene": "/dialogue/grocery-store/checking-out/bg.png",
      "audioUrl": "/dialogue/grocery-store/checking-out/audio/lee-06.mp3"
    }
  ],

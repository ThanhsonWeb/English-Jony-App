      "practicePriority": "important",
      "scene": "/dialogue/grocery-store/making-a-shopping-list/bg.png",
      "audioUrl": "/dialogue/grocery-store/making-a-shopping-list/audio/ben-03.mp3"
    },
    {
      "id": 6,
      "speaker": "Emma",
      "text": "What about fruit?",

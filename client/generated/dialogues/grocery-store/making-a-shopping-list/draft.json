      "scene": "/dialogue/grocery-store/making-a-shopping-list/bg.png",
      "audioUrl": "/dialogue/grocery-store/making-a-shopping-list/audio/emma-02.mp3"
    },
    {
      "id": 5,
      "speaker": "Ben",
      "text": "No, we don't. Let's buy one loaf.",

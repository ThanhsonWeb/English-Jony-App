  "dialogue": [
    {
      "id": 1,
      "speaker": "Ben",
      "text": "We need some food for this week.",
      "translation": "Chúng ta cần một ít đồ ăn cho tuần này.",
      "practicePriority": "important",
      "scene": "/dialogue/grocery-store/making-a-shopping-list/bg.png",
      "audioUrl": "/dialogue/grocery-store/making-a-shopping-list/audio/ben-01.mp3"
    },
    {
      "id": 2,
      "speaker": "Emma",
      "text": "Okay. What do we need?",
      "translation": "Được rồi. Chúng ta cần gì?",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/grocery-store/making-a-shopping-list/bg.png",
      "audioUrl": "/dialogue/grocery-store/making-a-shopping-list/audio/emma-01.mp3"
    },
    {
      "id": 3,
      "speaker": "Ben",
      "text": "We need some milk and eggs.",
      "translation": "Chúng ta cần một ít sữa và trứng.",
      "practicePriority": "important",
      "scene": "/dialogue/grocery-store/making-a-shopping-list/bg.png",
      "audioUrl": "/dialogue/grocery-store/making-a-shopping-list/audio/ben-02.mp3"
    },
    {
      "id": 4,
      "speaker": "Emma",
      "text": "Do we have any bread at home?",
      "translation": "Ở nhà chúng ta còn bánh mì không?",

  },
  "dialogue": [
    {
      "id": 1,
      "speaker": "Ben",
      "text": "It is nice to walk here after work.",
      "translation": "Đi dạo ở đây sau giờ làm thật dễ chịu.",
      "practicePriority": "simple",
      "scene": "/dialogue/walk-in-the-park/talking-about-work/bg.png",
      "audioUrl": "/dialogue/walk-in-the-park/talking-about-work/audio/ben-01.mp3"
    },
    {
      "id": 2,
      "speaker": "Ben",
      "text": "Where do you work, Emma?",
      "translation": "Emma, bạn làm việc ở đâu?",
      "practicePriority": "important",
      "scene": "/dialogue/walk-in-the-park/talking-about-work/bg.png",
      "audioUrl": "/dialogue/walk-in-the-park/talking-about-work/audio/ben-02.mp3"
    },
    {
      "id": 3,
      "speaker": "Emma",
      "text": "I work at a school close to home.",
      "translation": "Mình làm việc ở một trường học gần nhà.",
      "practicePriority": "important",
      "scene": "/dialogue/walk-in-the-park/talking-about-work/bg.png",
      "audioUrl": "/dialogue/walk-in-the-park/talking-about-work/audio/emma-01.mp3"
    },
    {
      "id": 4,
      "speaker": "Ben",
      "text": "Are you a teacher there?",
      "translation": "Bạn là giáo viên ở đó à?",
      "practicePriority": "important",
      "scene": "/dialogue/walk-in-the-park/talking-about-work/bg.png",
      "audioUrl": "/dialogue/walk-in-the-park/talking-about-work/audio/ben-03.mp3"
    },
    {
      "id": 5,
      "speaker": "Emma",
      "text": "Yes, I am. I teach English to children.",
      "translation": "Đúng vậy. Mình dạy tiếng Anh cho trẻ em.",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/walk-in-the-park/talking-about-work/bg.png",
      "audioUrl": "/dialogue/walk-in-the-park/talking-about-work/audio/emma-02.mp3"
    },
    {
      "id": 6,
      "speaker": "Emma",
      "text": "Where do you work, Ben?",
      "translation": "Còn bạn làm việc ở đâu, Ben?",
      "practicePriority": "important",
      "scene": "/dialogue/walk-in-the-park/talking-about-work/bg.png",
      "audioUrl": "/dialogue/walk-in-the-park/talking-about-work/audio/emma-03.mp3"
    },
    {
      "id": 7,
      "speaker": "Ben",
      "text": "I work at a company in the city.",
      "translation": "Mình làm việc ở một công ty trong thành phố.",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/walk-in-the-park/talking-about-work/bg.png",
      "audioUrl": "/dialogue/walk-in-the-park/talking-about-work/audio/ben-04.mp3"
    },
    {
      "id": 8,
      "speaker": "Ben",
      "text": "I use a computer every day.",
      "translation": "Mình dùng máy tính mỗi ngày.",
      "practicePriority": "important",
      "scene": "/dialogue/walk-in-the-park/talking-about-work/bg.png",
      "audioUrl": "/dialogue/walk-in-the-park/talking-about-work/audio/ben-05.mp3"
    },
    {
      "id": 9,
      "speaker": "Emma",
      "text": "Do you like your job?",
      "translation": "Bạn có thích công việc của mình không?",
      "practicePriority": "important",
      "scene": "/dialogue/walk-in-the-park/talking-about-work/bg.png",
      "audioUrl": "/dialogue/walk-in-the-park/talking-about-work/audio/emma-04.mp3"
    },
    {
      "id": 10,
      "speaker": "Ben",
      "text": "Yes, I do. My coworkers are very nice.",
      "translation": "Có. Đồng nghiệp của mình rất tốt.",
      "practicePriority": "important",
      "scene": "/dialogue/walk-in-the-park/talking-about-work/bg.png",
      "audioUrl": "/dialogue/walk-in-the-park/talking-about-work/audio/ben-06.mp3"
    },
    {
      "id": 11,
      "speaker": "Ben",
      "text": "Do you like your job too?",
      "translation": "Bạn cũng thích công việc của mình chứ?",
      "practicePriority": "important",
      "scene": "/dialogue/walk-in-the-park/talking-about-work/bg.png",
      "audioUrl": "/dialogue/walk-in-the-park/talking-about-work/audio/ben-07.mp3"
    },
    {
      "id": 12,
      "speaker": "Emma",
      "text": "Yes, I do. I like helping my students.",
      "translation": "Có. Mình thích giúp đỡ học sinh của mình.",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/walk-in-the-park/talking-about-work/bg.png",
      "audioUrl": "/dialogue/walk-in-the-park/talking-about-work/audio/emma-05.mp3"
    }
  ],

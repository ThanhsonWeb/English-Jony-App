  "grammarNotes": [
    {
      "title": "Gọi món lịch sự với “would like”",
      "explanation": "Dùng “I would like + món ăn hoặc đồ uống” để nói mình muốn gọi gì một cách lịch sự.",
      "example": "I would like the tomato soup, please."
    },
    {
      "title": "Yêu cầu lịch sự với “Can I have...?”",
      "explanation": "Dùng “Can I have + món hoặc đồ uống?” để yêu cầu một thứ gì đó một cách lịch sự.",
      "example": "Can I have some bread too?"
    }
  ]

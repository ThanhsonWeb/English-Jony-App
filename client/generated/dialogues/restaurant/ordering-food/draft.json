    "title": "Gọi món",
    "level": "a1",
    "a1ContentRulesVersion": 2,
    "teachesContractions": [],
    "situation": "Alex đến nhận món. Ben và Emma gọi món ăn và đồ uống bằng những câu đơn giản, lịch sự.",
    "scene": "/dialogue/restaurant/ordering-food/bg.png",
    "thumbnail": "/dialogue/restaurant/thumbnails/ordering-food.png"
  },
  "dialogue": [
    {
      "id": 1,
      "speaker": "Alex",
      "text": "Are you ready to order?",
      "translation": "Hai bạn đã sẵn sàng gọi món chưa?",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/restaurant/ordering-food/bg.png",
      "audioUrl": "/dialogue/restaurant/ordering-food/audio/alex-01.mp3"
    },
    {
      "id": 2,
      "speaker": "Ben",
      "text": "Yes, please. I would like the chicken pasta.",
      "translation": "Vâng. Tôi muốn món mì Ý gà.",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/restaurant/ordering-food/bg.png",
      "audioUrl": "/dialogue/restaurant/ordering-food/audio/ben-01.mp3"
    },
    {
      "id": 3,
      "speaker": "Ben",
      "text": "And a glass of water, please.",
      "translation": "Và một ly nước nữa nhé.",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/ordering-food/bg.png",
      "audioUrl": "/dialogue/restaurant/ordering-food/audio/ben-02.mp3"
    },
    {
      "id": 4,
      "speaker": "Alex",
      "text": "Sure. Would you like anything else?",
      "translation": "Được. Bạn có muốn thêm gì nữa không?",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/ordering-food/bg.png",
      "audioUrl": "/dialogue/restaurant/ordering-food/audio/alex-02.mp3"
    },
    {
      "id": 5,
      "speaker": "Emma",
      "text": "Yes. I would like the tomato soup, please.",
      "translation": "Có. Tôi muốn món súp cà chua.",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/restaurant/ordering-food/bg.png",
      "audioUrl": "/dialogue/restaurant/ordering-food/audio/emma-01.mp3"
    },
    {
      "id": 6,
      "speaker": "Emma",
      "text": "Can I have some bread too?",
      "translation": "Tôi có thể gọi thêm một ít bánh mì không?",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/ordering-food/bg.png",
      "audioUrl": "/dialogue/restaurant/ordering-food/audio/emma-02.mp3"
    },
    {
      "id": 7,
      "speaker": "Alex",
      "text": "Of course. What would you like to drink?",
      "translation": "Tất nhiên. Bạn muốn uống gì?",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/ordering-food/bg.png",
      "audioUrl": "/dialogue/restaurant/ordering-food/audio/alex-03.mp3"
    },
    {
      "id": 8,
      "speaker": "Emma",
      "text": "Orange juice, please.",
      "translation": "Nước cam nhé.",
      "practicePriority": "simple",
      "scene": "/dialogue/restaurant/ordering-food/bg.png",
      "audioUrl": "/dialogue/restaurant/ordering-food/audio/emma-03.mp3"
    },
    {
      "id": 9,
      "speaker": "Alex",
      "text": "Okay. One chicken pasta, one tomato soup, water, and orange juice.",
      "translation": "Được. Một mì Ý gà, một súp cà chua, nước lọc và nước cam.",
      "practicePriority": "important",
      "scene": "/dialogue/restaurant/ordering-food/bg.png",
      "audioUrl": "/dialogue/restaurant/ordering-food/audio/alex-04.mp3"
    },
    {
      "id": 10,
      "speaker": "Ben",
      "text": "Yes, that is right.",
      "translation": "Vâng, đúng rồi.",
      "practicePriority": "simple",
      "scene": "/dialogue/restaurant/ordering-food/bg.png",
      "audioUrl": "/dialogue/restaurant/ordering-food/audio/ben-03.mp3"
    },
    {
      "id": 11,
      "speaker": "Alex",
      "text": "Great. Thank you.",
      "translation": "Tuyệt. Cảm ơn hai bạn.",
      "practicePriority": "simple",
      "scene": "/dialogue/restaurant/ordering-food/bg.png",
      "audioUrl": "/dialogue/restaurant/ordering-food/audio/alex-05.mp3"
    }
  ],

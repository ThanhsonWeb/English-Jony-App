{
"metadata": {
"courseId": "weekend-camping",
"dialogueId": "arriving-at-the-campsite",
"title": "Đến khu cắm trại",
"level": "a1",
"situation": "Leo and Mia arrive at the campsite and choose a suitable place for their tent.",
"scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
"thumbnail": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png"
},
"dialogue": [
{
"id": 1,
"speaker": "Leo",
"text": "This campsite is nice and quiet.",
"translation": "Khu cắm trại này đẹp và yên tĩnh.",
"scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
"audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/leo-01.mp3"
},
{
"id": 2,
"speaker": "Mia",
"text": "Yes! Where can we put our tent?",
"translation": "Ừ! Mình có thể dựng lều ở đâu nhỉ?",
"scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
"audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/mia-01.mp3"
},
{
"id": 3,
"speaker": "Leo",
"text": "How about that place near the lake?",
"translation": "Chỗ kia gần hồ thì sao?",
"scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
"audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/leo-02.mp3"
},
{
"id": 4,
"speaker": "Mia",
"text": "It's nice, but it's too sunny.",
"translation": "Chỗ đó đẹp, nhưng nắng quá.",
"scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
"audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/mia-02.mp3"
},
{
"id": 5,
"speaker": "Leo",
"text": "What about under this tree?",
"translation": "Thế còn dưới gốc cây này thì sao?",
"scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
"audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/leo-03.mp3"
},
{
"id": 6,
"speaker": "Mia",
"text": "Yes, there's some shade here.",
"translation": "Ừ, ở đây có bóng mát.",
"scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
"audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/mia-03.mp3"
},
{
"id": 7,
"speaker": "Mia",
"text": "Is there enough space for our tent?",
"translation": "Có đủ chỗ cho lều của mình không?",
"scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
"audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/mia-04.mp3"
},
{
"id": 8,
"speaker": "Leo",
"text": "Yes, our tent is small.",
"translation": "Có chứ, lều của mình nhỏ mà.",
"scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
"audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/leo-04.mp3"
},
{
"id": 9,
"speaker": "Mia",
"text": "Great! Let's camp here.",
"translation": "Tuyệt! Mình cắm trại ở đây nhé.",
"scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
"audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/mia-05.mp3"
},
{
"id": 10,
"speaker": "Leo",
"text": "Good idea! It's near the lake, too.",
"translation": "Ý hay đấy! Chỗ này cũng gần hồ nữa.",
"scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
"audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/leo-05.mp3"
}
],

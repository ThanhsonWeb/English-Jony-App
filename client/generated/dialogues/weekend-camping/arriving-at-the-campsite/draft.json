"grammarNotes": [
{
"title": "Gợi ý với How about / What about",
"explanation": "Dùng “How about…?” hoặc “What about…?” để gợi ý một lựa chọn, nghĩa là “… thì sao?”. Trong hội thoại, Leo dùng hai mẫu này để gợi ý chỗ dựng lều.",
"example": "What about under this tree?"
},
{
"title": "Rủ cùng làm với Let's",
"explanation": "Dùng “Let's + động từ” để rủ ai đó cùng làm việc gì, nghĩa là “Mình cùng… nhé”. Sau “Let's”, giữ nguyên động từ.",
"example": "Let's camp here."
}
]

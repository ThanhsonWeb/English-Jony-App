  },
  "dialogue": [
    {
      "id": 1,
      "speaker": "Leo",
      "text": "We are here. This campsite looks nice.",
      "translation": "Chúng ta đến rồi. Khu cắm trại này trông đẹp đấy.",
      "practicePriority": "simple",
      "scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
      "audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/leo-01.mp3"
    },
    {
      "id": 2,
      "speaker": "Mia",
      "text": "Yes. We need a good place for the tent.",
      "translation": "Ừ. Chúng ta cần một chỗ tốt để dựng lều.",
      "practicePriority": "important",
      "scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
      "audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/mia-01.mp3"
    },
    {
      "id": 3,
      "speaker": "Leo",
      "text": "What about the space near those trees?",
      "translation": "Chỗ gần những cái cây kia thì sao?",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
      "audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/leo-02.mp3"
    },
    {
      "id": 4,
      "speaker": "Mia",
      "text": "It looks good, but the ground is a little wet.",
      "translation": "Trông ổn đấy, nhưng mặt đất hơi ướt.",
      "practicePriority": "important",
      "scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
      "audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/mia-02.mp3"
    },
    {
      "id": 5,
      "speaker": "Leo",
      "text": "You're right. We can look over there.",
      "translation": "Bạn nói đúng. Chúng ta có thể xem chỗ đằng kia.",
      "practicePriority": "simple",
      "scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
      "audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/leo-03.mp3"
    },
    {
      "id": 6,
      "speaker": "Mia",
      "text": "That spot is flat and dry.",
      "translation": "Chỗ đó bằng phẳng và khô.",
      "practicePriority": "important",
      "scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
      "audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/mia-03.mp3"
    },
    {
      "id": 7,
      "speaker": "Leo",
      "text": "Is there enough space for the tent?",
      "translation": "Có đủ chỗ cho cái lều không?",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
      "audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/leo-04.mp3"
    },
    {
      "id": 8,
      "speaker": "Mia",
      "text": "Yes, there is. It is also close to the water.",
      "translation": "Có. Chỗ này cũng gần nguồn nước.",
      "practicePriority": "important",
      "scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
      "audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/mia-04.mp3"
    },
    {
      "id": 9,
      "speaker": "Leo",
      "text": "Is it too close to the water?",
      "translation": "Nó có quá gần nước không?",
      "practicePriority": "important",
      "scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
      "audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/leo-05.mp3"
    },
    {
      "id": 10,
      "speaker": "Mia",
      "text": "No, I think this spot is safe.",
      "translation": "Không, mình nghĩ chỗ này an toàn.",
      "practicePriority": "simple",
      "scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
      "audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/mia-05.mp3"
    },
    {
      "id": 11,
      "speaker": "Leo",
      "text": "Good. This is the best place for our tent.",
      "translation": "Tốt. Đây là chỗ tốt nhất cho lều của chúng ta.",
      "practicePriority": "veryImportant",
      "scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
      "audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/leo-06.mp3"
    },
    {
      "id": 12,
      "speaker": "Mia",
      "text": "Great. We can stay here tonight.",
      "translation": "Tuyệt. Tối nay chúng ta có thể ở đây.",
      "practicePriority": "simple",
      "scene": "/dialogue/weekend-camping/arriving-at-the-campsite/bg.png",
      "audioUrl": "/dialogue/weekend-camping/arriving-at-the-campsite/audio/mia-06.mp3"
    }
  ],

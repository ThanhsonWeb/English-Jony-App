	"dialogue": [
		{
			"id": 1,
			"speaker": "Ben",
			"text": "Hi. I'd like to check in, please.",
			"translation": "Chào bạn. Tôi muốn làm thủ tục nhận phòng.",
			"practicePriority": "veryImportant",
			"scene": "/dialogue/at-a-hotel/checking-in/bg.png",
			"audioUrl": "/dialogue/at-a-hotel/checking-in/audio/ben-01.mp3"
		},
		{
			"id": 2,
			"speaker": "Maya",
			"text": "Of course. What's your name?",
			"translation": "Tất nhiên. Tên của bạn là gì?",
			"practicePriority": "simple",
			"scene": "/dialogue/at-a-hotel/checking-in/bg.png",
			"audioUrl": "/dialogue/at-a-hotel/checking-in/audio/maya-01.mp3"
		},
		{
			"id": 3,
			"speaker": "Ben",
			"text": "Ben Carter. I have a reservation.",
			"translation": "Ben Carter. Tôi đã đặt phòng trước.",
			"practicePriority": "veryImportant",
			"scene": "/dialogue/at-a-hotel/checking-in/bg.png",
			"audioUrl": "/dialogue/at-a-hotel/checking-in/audio/ben-02.mp3"
		},
		{
			"id": 4,
			"speaker": "Maya",
			"text": "Great. How many nights are you staying?",
			"translation": "Tốt. Bạn sẽ ở bao nhiêu đêm?",
			"practicePriority": "important",
			"scene": "/dialogue/at-a-hotel/checking-in/bg.png",
			"audioUrl": "/dialogue/at-a-hotel/checking-in/audio/maya-02.mp3"
		},
		{
			"id": 5,
			"speaker": "Ben",
			"text": "Three nights.",
			"translation": "Ba đêm.",
			"practicePriority": "simple",
			"scene": "/dialogue/at-a-hotel/checking-in/bg.png",
			"audioUrl": "/dialogue/at-a-hotel/checking-in/audio/ben-03.mp3"
		},
		{
			"id": 6,
			"speaker": "Maya",
			"text": "Perfect. Your room is 204, on the second floor.",
			"translation": "Tuyệt. Phòng của bạn là phòng 204, ở tầng hai.",
			"practicePriority": "important",
			"scene": "/dialogue/at-a-hotel/checking-in/bg.png",
			"audioUrl": "/dialogue/at-a-hotel/checking-in/audio/maya-03.mp3"
		},
		{
			"id": 7,
			"speaker": "Maya",
			"text": "Your key card is ready.",
			"translation": "Thẻ phòng của bạn đã sẵn sàng.",
			"practicePriority": "simple",
			"scene": "/dialogue/at-a-hotel/checking-in/bg.png",
			"audioUrl": "/dialogue/at-a-hotel/checking-in/audio/maya-04.mp3"
		},
		{
			"id": 8,
			"speaker": "Ben",
			"text": "Great. Thank you.",
			"translation": "Tuyệt. Cảm ơn bạn.",
			"practicePriority": "simple",
			"scene": "/dialogue/at-a-hotel/checking-in/bg.png",
			"audioUrl": "/dialogue/at-a-hotel/checking-in/audio/ben-04.mp3"
		},
		{
			"id": 9,
			"speaker": "Maya",
			"text": "You're welcome. Enjoy your stay.",
			"translation": "Không có gì. Chúc bạn có kỳ nghỉ vui vẻ.",

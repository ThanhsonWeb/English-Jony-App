"dialogue": [
{
"id": 1,
"speaker": "Maya",
"text": "Good morning. How can I help you?",
"translation": "Chào buổi sáng. Tôi có thể giúp gì cho bạn?",
"practicePriority": "simple",
"scene": "/dialogue/at-a-hotel/checking-out/bg.png",
"audioUrl": "/dialogue/at-a-hotel/checking-out/audio/maya-01.mp3"
},
{
"id": 2,
"speaker": "Ben",
"text": "Hi. I'd like to check out, please.",
"translation": "Chào bạn. Tôi muốn làm thủ tục trả phòng.",
"practicePriority": "veryImportant",
"scene": "/dialogue/at-a-hotel/checking-out/bg.png",
"audioUrl": "/dialogue/at-a-hotel/checking-out/audio/ben-01.mp3"
},
{
"id": 3,
"speaker": "Maya",
"text": "Of course. What is your room number?",
"translation": "Tất nhiên. Số phòng của bạn là bao nhiêu?",
"practicePriority": "important",
"scene": "/dialogue/at-a-hotel/checking-out/bg.png",
"audioUrl": "/dialogue/at-a-hotel/checking-out/audio/maya-02.mp3"
},
{
"id": 4,
"speaker": "Ben",
"text": "Room 305.",
"translation": "Phòng 305.",
"practicePriority": "simple",
"scene": "/dialogue/at-a-hotel/checking-out/bg.png",
"audioUrl": "/dialogue/at-a-hotel/checking-out/audio/ben-02.mp3"
},
{
"id": 5,
"speaker": "Maya",
"text": "Thank you. Let me check your bill.",
"translation": "Cảm ơn bạn. Để tôi kiểm tra hóa đơn của bạn.",
"practicePriority": "important",
"scene": "/dialogue/at-a-hotel/checking-out/bg.png",
"audioUrl": "/dialogue/at-a-hotel/checking-out/audio/maya-03.mp3"
},
{
"id": 6,
"speaker": "Maya",
"text": "Your total is eighty dollars.",
"translation": "Tổng cộng là tám mươi đô la.",
"practicePriority": "important",
"scene": "/dialogue/at-a-hotel/checking-out/bg.png",
"audioUrl": "/dialogue/at-a-hotel/checking-out/audio/maya-04.mp3"
},
{
"id": 7,
"speaker": "Ben",
"text": "Okay. Can I pay by card?",
"translation": "Được rồi. Tôi có thể thanh toán bằng thẻ không?",
"practicePriority": "veryImportant",
"scene": "/dialogue/at-a-hotel/checking-out/bg.png",
"audioUrl": "/dialogue/at-a-hotel/checking-out/audio/ben-03.mp3"
},
{
"id": 8,
"speaker": "Maya",
"text": "Yes, you can.",
"translation": "Có, bạn có thể.",
"practicePriority": "simple",
"scene": "/dialogue/at-a-hotel/checking-out/bg.png",
"audioUrl": "/dialogue/at-a-hotel/checking-out/audio/maya-05.mp3"
},
{
"id": 9,
"speaker": "Ben",
"text": "Great. Is everything paid now?",
"translation": "Tuyệt. Bây giờ mọi thứ đã được thanh toán chưa?",
"practicePriority": "important",
"scene": "/dialogue/at-a-hotel/checking-out/bg.png",
"audioUrl": "/dialogue/at-a-hotel/checking-out/audio/ben-04.mp3"
},
{
"id": 10,
"speaker": "Maya",
"text": "Yes. Everything is paid. Thank you for staying with us.",
"translation": "Vâng. Mọi thứ đã được thanh toán. Cảm ơn bạn đã ở tại khách sạn của chúng tôi.",
"practicePriority": "simple",
"scene": "/dialogue/at-a-hotel/checking-out/bg.png",
"audioUrl": "/dialogue/at-a-hotel/checking-out/audio/maya-06.mp3"
},
{
"id": 11,
"speaker": "Ben",
"text": "Thank you. I had a nice stay.",

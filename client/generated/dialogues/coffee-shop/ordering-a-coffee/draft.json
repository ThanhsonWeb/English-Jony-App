"courseId": "coffee-shop",
"dialogueId": "ordering-a-coffee",
"title": "Gọi cà phê",
"level": "a1",
"situation": "Ben và Emma đến một quán cà phê cùng nhau. Ben muốn gọi cà phê nhưng chưa biết chọn loại nào, nên Emma gợi ý cho Ben trước khi nhân viên quán nhận món.",
"scene": "/dialogue/coffee-shop/ordering-a-coffee/bg.png",
"thumbnail": "/dialogue/coffee-shop/thumbnails/ordering-a-coffee.png"
},
"dialogue": [
{
"id": 1,
"speaker": "Ben",
"text": "There are so many drinks on this menu.",
"practicePriority": "simple",
"translation": "Có nhiều đồ uống quá trên thực đơn này.",
"scene": "/dialogue/coffee-shop/ordering-a-coffee/bg.png",
"audioUrl": "/dialogue/coffee-shop/ordering-a-coffee/audio/ben-01.mp3"
},
{
"id": 2,
"speaker": "Emma",
"text": "What kind of coffee do you like?",
"practicePriority": "veryImportant",
"translation": "Bạn thích loại cà phê nào?",
"scene": "/dialogue/coffee-shop/ordering-a-coffee/bg.png",
"audioUrl": "/dialogue/coffee-shop/ordering-a-coffee/audio/emma-01.mp3"
},
{
"id": 3,
"speaker": "Ben",
"text": "I like coffee, but I don't like it very strong.",
"practicePriority": "important",
"translation": "Mình thích cà phê, nhưng mình không thích cà phê quá đậm.",
"scene": "/dialogue/coffee-shop/ordering-a-coffee/bg.png",
"audioUrl": "/dialogue/coffee-shop/ordering-a-coffee/audio/ben-02.mp3"
},
{
"id": 4,
"speaker": "Emma",
"text": "Then you can try a latte.",
"practicePriority": "important",
"translation": "Vậy bạn có thể thử latte.",
"scene": "/dialogue/coffee-shop/ordering-a-coffee/bg.png",
"audioUrl": "/dialogue/coffee-shop/ordering-a-coffee/audio/emma-02.mp3"
},
{
"id": 5,
"speaker": "Emma",
"text": "It has coffee and a lot of milk.",
"practicePriority": "simple",
"translation": "Nó có cà phê và nhiều sữa.",
"scene": "/dialogue/coffee-shop/ordering-a-coffee/bg.png",
"audioUrl": "/dialogue/coffee-shop/ordering-a-coffee/audio/emma-03.mp3"
},
{
"id": 6,
"speaker": "Ben",
"text": "That sounds good. Is it sweet?",
"practicePriority": "important",
"translation": "Nghe ngon đấy. Nó có ngọt không?",
"scene": "/dialogue/coffee-shop/ordering-a-coffee/bg.png",
"audioUrl": "/dialogue/coffee-shop/ordering-a-coffee/audio/ben-03.mp3"
},
{
"id": 7,
"speaker": "Emma",
"text": "No, but you can add some sugar.",
"practicePriority": "important",
"translation": "Không, nhưng bạn có thể thêm một ít đường.",
"scene": "/dialogue/coffee-shop/ordering-a-coffee/bg.png",
"audioUrl": "/dialogue/coffee-shop/ordering-a-coffee/audio/emma-04.mp3"
},
{
"id": 8,
"speaker": "Ben",
"text": "Okay. I'll get a small latte.",
"practicePriority": "veryImportant",
"translation": "Được rồi. Mình sẽ gọi một ly latte nhỏ.",
"scene": "/dialogue/coffee-shop/ordering-a-coffee/bg.png",
"audioUrl": "/dialogue/coffee-shop/ordering-a-coffee/audio/ben-04.mp3"
},
{
"id": 9,
"speaker": "Emma",
"text": "Good choice. I want an iced coffee.",
"practicePriority": "simple",
"translation": "Lựa chọn hay đấy. Mình muốn một ly cà phê đá.",
"scene": "/dialogue/coffee-shop/ordering-a-coffee/bg.png",
"audioUrl": "/dialogue/coffee-shop/ordering-a-coffee/audio/emma-05.mp3"
},
{
"id": 10,
"speaker": "Ben",
"text": "Great. We're ready to order now.",
"practicePriority": "important",
"translation": "Tuyệt. Giờ chúng ta sẵn sàng gọi món rồi.",
"scene": "/dialogue/coffee-shop/ordering-a-coffee/bg.png",
"audioUrl": "/dialogue/coffee-shop/ordering-a-coffee/audio/ben-05.mp3"
}
],
